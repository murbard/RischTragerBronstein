import RischTragerBronstein.Algebraic.EllCertValid
import RischTragerBronstein.Elliptic.Dedekind

/-!
# Existence of the function `u` when the residue divisor is torsion

For `∑ mᵢ Qᵢ = 0` in `E(K)` (any field `K` of characteristic zero) (`Qᵢ = (αᵢ, yᵢ)`): the ideal `∏ ⟨x − αᵢ, y − yᵢ⟩^{mᵢ}` of the Dedekind
coordinate ring is principal (`Point.toClass` is injective), generated by some `g = A + B y`;
`g` vanishes to order `mᵢ` at `Qᵢ` (`locVal_dvd_of_mem`, via the evaluation `x ↦ αᵢ + t`,
`y ↦ Y_q(t)` into `K[t]/(t^m)`), and its norm divides `∏ (x − αᵢ)^{mᵢ}` (conjugation `y ↦ −y`),
which bounds the degrees of `A`, `B`.
-/

open Polynomial WeierstrassCurve WeierstrassCurve.Affine WeierstrassCurve.Affine.CoordinateRing
open scoped nonZeroDivisors Polynomial.Bivariate

namespace EllAlgo

section Gen

variable {K : Type*} [Field K] [CharZero K] [DecidableEq K] (a₂ a₄ a₆ : K)

/-- The curve `y² = x³ + a₂x² + a₄x + a₆` over `K`. -/
abbrev WK : WeierstrassCurve.Affine K := (⟨0, a₂, 0, a₄, a₆⟩ : WeierstrassCurve K).toAffine

/-- Its coordinate ring. -/
abbrev RK : Type _ := (WK a₂ a₄ a₆).CoordinateRing

variable (pC : CPoly K) (hpC : CPoly.toPoly pC = X ^ 3 + C a₂ * X ^ 2 + C a₄ * X + C a₆)

/-- **Torsion relations give principal ideals.** -/
lemma isPrincipal_of_sum_eq_zero [IsDedekindDomain (RK a₂ a₄ a₆)] {ι' : Type*} (s : Finset ι')
    (x y : ι' → K) (h : ∀ i, (WK a₂ a₄ a₆).Nonsingular (x i) (y i)) (m : ι' → ℕ)
    (hsum : ∑ i ∈ s, m i • (Point.some _ _ (h i) : (WK a₂ a₄ a₆).Point) = 0) :
    (∏ i ∈ s, XYIdeal (WK a₂ a₄ a₆) (x i) (C (y i)) ^ m i).IsPrincipal := by
  have h1 := congrArg (fun P ↦ Additive.toMul (Point.toClass P)) hsum
  simp only [map_sum, map_nsmul, Point.toClass_some, map_zero, toMul_zero, toMul_sum,
    toMul_nsmul] at h1
  change ∏ i ∈ s, ClassGroup.mk (WK a₂ a₄ a₆).FunctionField (CoordinateRing.XYIdeal' (h i)) ^ m i = 1 at h1
  simp only [← map_pow, ← map_prod] at h1
  have hp := ClassGroup.mk_eq_one_iff.mp h1
  have key : ((∏ i ∈ s, CoordinateRing.XYIdeal' (h i) ^ m i :
      (FractionalIdeal (RK a₂ a₄ a₆)⁰ (WK a₂ a₄ a₆).FunctionField)ˣ) :
        FractionalIdeal (RK a₂ a₄ a₆)⁰ (WK a₂ a₄ a₆).FunctionField) =
      FractionalIdeal.coeIdealHom (RK a₂ a₄ a₆)⁰ (WK a₂ a₄ a₆).FunctionField
        (∏ i ∈ s, XYIdeal (WK a₂ a₄ a₆) (x i) (C (y i)) ^ m i) := by
    rw [Units.coe_prod, map_prod]
    refine Finset.prod_congr rfl fun i _ ↦ ?_
    rw [Units.val_pow_eq_pow_val, map_pow, CoordinateRing.XYIdeal'_eq]
    rfl
  rw [key] at hp
  exact (IsFractionRing.coeSubmodule_isPrincipal (R := RK a₂ a₄ a₆) (K := (WK a₂ a₄ a₆).FunctionField)).mp hp

/-- `x ↦ α + t` into `K[t]/(tᵐ)`. -/
noncomputable def φ₀ (α : K) (m : ℕ) : K[X] →+* K[X] ⧸ Ideal.span {(X ^ m : K[X])} :=
  (Ideal.Quotient.mk _).comp (Polynomial.compRingHom (X + C α))

lemma polynomial_WQ : (WK a₂ a₄ a₆).polynomial =
    Polynomial.X ^ 2 - Polynomial.C (X ^ 3 + C a₂ * X ^ 2 + C a₄ * X + C a₆) := by
  simp only [Affine.polynomial, WK, map_zero, zero_mul, add_zero]

lemma eval₂_polynomial_WQ {S : Type*} [CommRing S] (i : K[X] →+* S) (r : S) :
    eval₂ i r (WK a₂ a₄ a₆).polynomial =
      r ^ 2 - i (X ^ 3 + C a₂ * X ^ 2 + C a₄ * X + C a₆) := by
  rw [polynomial_WQ]; simp only [eval₂_sub, eval₂_X_pow, eval₂_C]

/-- **The local evaluation** `R → K[t]/(tᵐ)`, `x ↦ α + t`, `y ↦ Y_q(t)`. -/
noncomputable def φloc (α y₀ : K) (m : ℕ) (hy₀ : y₀ ≠ 0)
    (hpα : (CPoly.toPoly (pC)).eval α = y₀ ^ 2) (hm : 1 ≤ m) :
    RK a₂ a₄ a₆ →+* K[X] ⧸ Ideal.span {(X ^ m : K[X])} :=
  AdjoinRoot.lift (φ₀ α m) (Ideal.Quotient.mk _ (CPoly.toPoly (Yq (pC) (α, y₀, m)))) (by
    rw [eval₂_polynomial_WQ]
    rw [φ₀, RingHom.comp_apply, ← map_pow, ← map_sub, Ideal.Quotient.eq_zero_iff_mem,
      Ideal.mem_span_singleton]
    have hpt0 : (CPoly.toPoly (shiftPoly (pC) α)).coeff 0 = y₀ ^ 2 := by
      rw [toPoly_shiftPoly, coeff_zero_eq_eval_zero, eval_comp]; simpa using hpα
    have := sqrtSeries_dvd (shiftPoly (pC) α) y₀ hy₀ hpt0 m hm
    rw [toPoly_shiftPoly, hpC] at this
    rw [← dvd_neg, neg_sub]
    simpa [Yq, coe_compRingHom_apply] using this)

lemma φloc_smul (α y₀ : K) (m : ℕ) (hy₀ : y₀ ≠ 0)
    (hpα : (CPoly.toPoly (pC)).eval α = y₀ ^ 2) (hm : 1 ≤ m) (A B : K[X]) :
    φloc a₂ a₄ a₆ pC hpC α y₀ m hy₀ hpα hm (A • (1 : RK a₂ a₄ a₆) + B • CoordinateRing.mk (WK a₂ a₄ a₆) Y) =
      Ideal.Quotient.mk _ (locVal (pC) A B (α, y₀, m)) := by
  rw [CoordinateRing.smul, CoordinateRing.smul, mul_one, map_add, map_mul]
  simp only [φloc, CoordinateRing.mk, AdjoinRoot.mk_C, AdjoinRoot.lift_of, AdjoinRoot.mk_X,
    AdjoinRoot.lift_root, φ₀, RingHom.comp_apply, coe_compRingHom_apply, locVal, map_add, map_mul]

include hpC in
/-- **Vanishing to order `m`**: an element of `⟨x − α, y − y₀⟩ᵐ` has `tᵐ ∣ locVal`. -/
lemma locVal_dvd_of_mem (α y₀ : K) (m : ℕ) (hy₀ : y₀ ≠ 0)
    (hpα : (CPoly.toPoly (pC)).eval α = y₀ ^ 2) (hm : 1 ≤ m) (A B : K[X])
    (hmem : A • (1 : RK a₂ a₄ a₆) + B • CoordinateRing.mk (WK a₂ a₄ a₆) Y ∈
      XYIdeal (WK a₂ a₄ a₆) α (C y₀) ^ m) :
    X ^ m ∣ locVal (pC) A B (α, y₀, m) := by
  set φ := φloc a₂ a₄ a₆ pC hpC α y₀ m hy₀ hpα hm
  have hle : Ideal.map φ (XYIdeal (WK a₂ a₄ a₆) α (C y₀)) ≤
      Ideal.span {Ideal.Quotient.mk _ (X : K[X])} := by
    rw [XYIdeal, Ideal.map_span, Ideal.span_le]
    rintro _ ⟨g, hg, rfl⟩
    rcases hg with rfl | rfl
    · simp only [XClass, φ, φloc, CoordinateRing.mk, AdjoinRoot.mk_C, AdjoinRoot.lift_of, φ₀,
        RingHom.comp_apply, coe_compRingHom_apply, sub_comp, X_comp, C_comp, add_sub_cancel_right]
      exact Ideal.subset_span rfl
    · simp only [YClass, φ, φloc, CoordinateRing.mk, map_sub, AdjoinRoot.mk_X, AdjoinRoot.lift_root,
        AdjoinRoot.mk_C, AdjoinRoot.lift_of, φ₀, RingHom.comp_apply, coe_compRingHom_apply, C_comp]
      rw [← map_sub, SetLike.mem_coe, Ideal.mem_span_singleton]
      obtain ⟨Z, hZ⟩ : X ∣ CPoly.toPoly (Yq (pC) (α, y₀, m)) - C y₀ := by
        rw [X_dvd_iff, coeff_sub, coeff_C_zero, Yq, coeff_zero_sqrtSeries, sub_self]
      rw [hZ, map_mul]
      exact dvd_mul_right _ _
  have hle' : Ideal.map φ (XYIdeal (WK a₂ a₄ a₆) α (C y₀) ^ m) = ⊥ := by
    rw [Ideal.map_pow]
    refine le_bot_iff.mp ((Ideal.pow_right_mono hle m).trans ?_)
    rw [Ideal.span_singleton_pow, ← map_pow, (Ideal.Quotient.eq_zero_iff_mem).mpr
      (Ideal.mem_span_singleton_self _), Ideal.span_singleton_eq_bot.mpr rfl]
  have h0 : φ (A • (1 : RK a₂ a₄ a₆) + B • CoordinateRing.mk (WK a₂ a₄ a₆) Y) = 0 := by
    have := Ideal.mem_map_of_mem φ hmem
    rwa [hle', Ideal.mem_bot] at this
  rw [φloc_smul, Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton] at h0
  exact h0

/-! ### Conjugation `y ↦ −y` and the norm -/

/-- `ι : K[X] → R`. -/
noncomputable abbrev ιQ : K[X] →+* RK a₂ a₄ a₆ := algebraMap K[X] (RK a₂ a₄ a₆)

/-- The conjugation `y ↦ −y`. -/
noncomputable def σ : RK a₂ a₄ a₆ →+* RK a₂ a₄ a₆ :=
  AdjoinRoot.lift (ιQ a₂ a₄ a₆) (-CoordinateRing.mk (WK a₂ a₄ a₆) Y) (by
    rw [eval₂_polynomial_WQ, neg_sq]
    have := AdjoinRoot.eval₂_root (WK a₂ a₄ a₆).polynomial
    rw [eval₂_polynomial_WQ] at this
    exact this)

lemma σ_ι (f : K[X]) : σ a₂ a₄ a₆ (ιQ a₂ a₄ a₆ f) = ιQ a₂ a₄ a₆ f := by
  simp only [σ]
  exact AdjoinRoot.lift_of _

lemma σ_Y : σ a₂ a₄ a₆ (CoordinateRing.mk (WK a₂ a₄ a₆) Y) = -CoordinateRing.mk (WK a₂ a₄ a₆) Y :=
  AdjoinRoot.lift_root _

lemma smul_one_eq (f : K[X]) : f • (1 : RK a₂ a₄ a₆) = ιQ a₂ a₄ a₆ f := by
  rw [Algebra.smul_def, mul_one]

lemma σ_basis (A B : K[X]) :
    σ a₂ a₄ a₆ (A • (1 : RK a₂ a₄ a₆) + B • CoordinateRing.mk (WK a₂ a₄ a₆) Y) =
      A • (1 : RK a₂ a₄ a₆) - B • CoordinateRing.mk (WK a₂ a₄ a₆) Y := by
  rw [Algebra.smul_def, Algebra.smul_def, map_add, map_mul, map_mul, map_one, mul_one, mul_one,
    σ_ι, σ_ι, σ_Y, mul_neg, ← sub_eq_add_neg]

lemma mkY_sq : CoordinateRing.mk (WK a₂ a₄ a₆) Y ^ 2 =
    ιQ a₂ a₄ a₆ (X ^ 3 + C a₂ * X ^ 2 + C a₄ * X + C a₆) := by
  have := AdjoinRoot.eval₂_root (WK a₂ a₄ a₆).polynomial
  rw [eval₂_polynomial_WQ, sub_eq_zero] at this
  simp only [CoordinateRing.mk]
  rw [AdjoinRoot.mk_X]
  exact this

include hpC in
lemma basis_mul_conj (A B : K[X]) :
    (A • (1 : RK a₂ a₄ a₆) + B • CoordinateRing.mk (WK a₂ a₄ a₆) Y) *
      (A • (1 : RK a₂ a₄ a₆) - B • CoordinateRing.mk (WK a₂ a₄ a₆) Y) =
      ιQ a₂ a₄ a₆ (A ^ 2 - B ^ 2 * CPoly.toPoly (pC)) := by
  rw [Algebra.smul_def, Algebra.smul_def, mul_one, hpC, map_sub, map_mul, map_pow, map_pow,
    ← mkY_sq]
  ring

lemma map_σ_XYIdeal (α y : K) :
    Ideal.map (σ a₂ a₄ a₆) (XYIdeal (WK a₂ a₄ a₆) α (C y)) = XYIdeal (WK a₂ a₄ a₆) α (C (-y)) := by
  rw [XYIdeal, XYIdeal, Ideal.map_span, Set.image_pair]
  have h1 : σ a₂ a₄ a₆ (XClass (WK a₂ a₄ a₆) α) = XClass (WK a₂ a₄ a₆) α := σ_ι a₂ a₄ a₆ _
  have h2 : σ a₂ a₄ a₆ (YClass (WK a₂ a₄ a₆) (C y)) = -YClass (WK a₂ a₄ a₆) (C (-y)) := by
    simp only [YClass, CoordinateRing.mk, map_sub]
    rw [show AdjoinRoot.mk (WK a₂ a₄ a₆).polynomial (Polynomial.C (C y)) = ιQ a₂ a₄ a₆ (C y) from rfl,
      σ_ι]
    rw [show AdjoinRoot.mk (WK a₂ a₄ a₆).polynomial Y = CoordinateRing.mk (WK a₂ a₄ a₆) Y from rfl, σ_Y]
    rw [show AdjoinRoot.mk (WK a₂ a₄ a₆).polynomial (Polynomial.C (C (-y))) = ιQ a₂ a₄ a₆ (C (-y))
      from rfl]
    simp only [map_neg]
    ring
  rw [h1, h2, Ideal.span_insert, Ideal.span_insert, Ideal.span_singleton_neg]

lemma XYIdeal_mul_neg (α y : K) (h : (WK a₂ a₄ a₆).Nonsingular α y) :
    XYIdeal (WK a₂ a₄ a₆) α (C y) * XYIdeal (WK a₂ a₄ a₆) α (C (-y)) =
      Ideal.span {ιQ a₂ a₄ a₆ (X - C α)} := by
  have := XYIdeal_neg_mul h
  rw [show (WK a₂ a₄ a₆).negY α y = -y by simp [negY, WK]] at this
  rw [mul_comm, this, XIdeal]
  rfl

/-- `ι P = r ι N` forces `N ∣ P` in `K[X]`. -/
lemma dvd_of_ι_mem_span (P N : K[X])
    (h : ιQ a₂ a₄ a₆ P ∈ Ideal.span {ιQ a₂ a₄ a₆ N}) : N ∣ P := by
  obtain ⟨r, hr⟩ := Ideal.mem_span_singleton'.mp h
  obtain ⟨r1, r2, rfl⟩ := CoordinateRing.exists_smul_basis_eq r
  have e : (r1 • (1 : RK a₂ a₄ a₆) + r2 • CoordinateRing.mk (WK a₂ a₄ a₆) Y) * ιQ a₂ a₄ a₆ N =
      (r1 * N) • (1 : RK a₂ a₄ a₆) + (r2 * N) • CoordinateRing.mk (WK a₂ a₄ a₆) Y :=
    CoordinateRing.smul_basis_mul_C _ _ _
  rw [e, ← smul_one_eq] at hr
  have h0 : (r1 * N - P) • (1 : RK a₂ a₄ a₆) + (r2 * N) • CoordinateRing.mk (WK a₂ a₄ a₆) Y = 0 := by
    rw [sub_smul, sub_add_eq_add_sub, hr, sub_self]
  obtain ⟨h1, -⟩ := CoordinateRing.smul_basis_eq_zero h0
  exact ⟨r1, by linear_combination -h1⟩

/-- The degrees of `A`, `B` are controlled by the degree of the norm. -/
lemma degrees_of_norm (p A B : K[X]) (hp : p.natDegree = 3) :
    2 * A.natDegree ≤ (A ^ 2 - B ^ 2 * p).natDegree ∧
      (B = 0 ∨ 2 * B.natDegree + 3 ≤ (A ^ 2 - B ^ 2 * p).natDegree) := by
  have hp0 : p ≠ 0 := by rintro rfl; simp at hp
  by_cases hB : B = 0
  · subst hB; simp [natDegree_pow]
  by_cases hA : A = 0
  · subst hA
    refine ⟨by simp, Or.inr ?_⟩
    rw [zero_pow two_ne_zero, zero_sub, natDegree_neg, natDegree_mul (pow_ne_zero 2 hB) hp0,
      natDegree_pow, hp]
  have h1 : (A ^ 2).natDegree = 2 * A.natDegree := natDegree_pow _ _
  have h2 : (B ^ 2 * p).natDegree = 2 * B.natDegree + 3 := by
    rw [natDegree_mul (pow_ne_zero 2 hB) hp0, natDegree_pow, hp]
  rcases Nat.lt_or_gt_of_ne (show 2 * A.natDegree ≠ 2 * B.natDegree + 3 by omega) with hlt | hlt
  · rw [natDegree_sub_eq_right_of_natDegree_lt (by omega)]
    exact ⟨by omega, Or.inr (by omega)⟩
  · rw [natDegree_sub_eq_left_of_natDegree_lt (by omega)]
    exact ⟨by omega, Or.inr (by omega)⟩

include hpC in
/-- **Existence of `u = A + B y`** vanishing to order `mᵢ` at `Qᵢ` when `∑ mᵢ Qᵢ = 0`, with
`deg A ≤ M₀/2`, `deg B ≤ (M₀ − 3)/2`. -/
theorem exists_localK (hsq : Squarefree (CPoly.toPoly (pC))) {ι' : Type*}
    (s : Finset ι') (α y : ι' → K) (h : ∀ i, (WK a₂ a₄ a₆).Nonsingular (α i) (y i))
    (hy : ∀ i ∈ s, y i ≠ 0) (m : ι' → ℕ)
    (hsum : ∑ i ∈ s, m i • (Point.some _ _ (h i) : (WK a₂ a₄ a₆).Point) = 0) :
    ∃ A B : K[X], (A ≠ 0 ∨ B ≠ 0) ∧ 2 * A.natDegree ≤ ∑ i ∈ s, m i ∧
      (B = 0 ∨ 2 * B.natDegree + 3 ≤ ∑ i ∈ s, m i) ∧
      ∀ i ∈ s, 1 ≤ m i → X ^ m i ∣ locVal (pC) A B (α i, y i, m i) := by
  have hsq' : Squarefree (X ^ 3 + C a₂ * X ^ 2 + C a₄ * X + C a₆) := by
    rwa [hpC] at hsq
  haveI : IsDedekindDomain (RK a₂ a₄ a₆) := isDedekindDomain_coordinateRing a₂ a₄ a₆ hsq'
  set Mi := ∏ i ∈ s, XYIdeal (WK a₂ a₄ a₆) (α i) (C (y i)) ^ m i with hMi
  obtain ⟨g, hg⟩ := (isPrincipal_of_sum_eq_zero a₂ a₄ a₆ s α y h m hsum).principal
  rw [← hMi] at hg
  obtain ⟨A, B, rfl⟩ := CoordinateRing.exists_smul_basis_eq g
  set p := CPoly.toPoly (pC) with hpdef
  have hp3 : p.natDegree = 3 := by rw [hpC]; compute_degree!
  -- `g ≠ 0`
  have hMi0 : Mi ≠ ⊥ := by
    rw [hMi, ← Ideal.zero_eq_bot, Finset.prod_ne_zero_iff]
    intro i _
    refine pow_ne_zero _ fun h0 ↦ XClass_ne_zero (W' := WK a₂ a₄ a₆) (α i) ?_
    have : XClass (WK a₂ a₄ a₆) (α i) ∈ XYIdeal (WK a₂ a₄ a₆) (α i) (C (y i)) :=
      Ideal.subset_span (Set.mem_insert _ _)
    rw [h0, Ideal.zero_eq_bot, Ideal.mem_bot] at this
    exact this
  have hAB : A ≠ 0 ∨ B ≠ 0 := by
    by_contra hc
    push_neg at hc
    apply hMi0
    rw [hg, hc.1, hc.2, zero_smul, zero_smul, add_zero]
    exact Ideal.span_singleton_eq_bot.mpr rfl
  -- the norm divides `∏ (x − αᵢ)^{mᵢ}`
  set P := ∏ i ∈ s, (X - C (α i)) ^ m i with hP
  have hP0 : P ≠ 0 := Finset.prod_ne_zero_iff.mpr fun i _ ↦ pow_ne_zero _ (X_sub_C_ne_zero _)
  have hMiMi' : Mi * Ideal.map (σ a₂ a₄ a₆) Mi = Ideal.span {ιQ a₂ a₄ a₆ P} := by
    have hmap : Ideal.map (σ a₂ a₄ a₆) Mi =
        ∏ i ∈ s, Ideal.map (σ a₂ a₄ a₆) (XYIdeal (WK a₂ a₄ a₆) (α i) (C (y i)) ^ m i) :=
      map_prod (Ideal.mapHom (σ a₂ a₄ a₆)) _ _
    rw [hmap, hMi, ← Finset.prod_mul_distrib, hP, map_prod,
      ← Ideal.prod_span_singleton]
    refine Finset.prod_congr rfl fun i _ ↦ ?_
    rw [Ideal.map_pow, map_σ_XYIdeal, ← mul_pow, XYIdeal_mul_neg a₂ a₄ a₆ _ _ (h i), map_pow,
      Ideal.span_singleton_pow]
  have hspan : Mi * Ideal.map (σ a₂ a₄ a₆) Mi = Ideal.span {ιQ a₂ a₄ a₆ (A ^ 2 - B ^ 2 * p)} := by
    rw [hg, Ideal.map_span, Set.image_singleton, Ideal.span_singleton_mul_span_singleton,
      σ_basis, basis_mul_conj a₂ a₄ a₆ pC hpC]
  have hNP : A ^ 2 - B ^ 2 * p ∣ P := by
    apply dvd_of_ι_mem_span a₂ a₄ a₆
    rw [← hspan, hMiMi']
    exact Ideal.mem_span_singleton_self _
  have hdegP : P.natDegree = ∑ i ∈ s, m i := by
    rw [hP, natDegree_prod_of_monic _ _ fun i _ ↦ (monic_X_sub_C _).pow _]
    exact Finset.sum_congr rfl fun i _ ↦ by rw [natDegree_pow, natDegree_X_sub_C, mul_one]
  have hdegN := natDegree_le_of_dvd hNP hP0
  obtain ⟨hA, hB⟩ := degrees_of_norm p A B hp3
  refine ⟨A, B, hAB, by omega, hB.imp_right (by omega), ?_⟩
  -- local vanishing
  intro i hi hm
  have hmem : A • (1 : RK a₂ a₄ a₆) + B • CoordinateRing.mk (WK a₂ a₄ a₆) Y ∈
      XYIdeal (WK a₂ a₄ a₆) (α i) (C (y i)) ^ m i := by
    have hle : Mi ≤ XYIdeal (WK a₂ a₄ a₆) (α i) (C (y i)) ^ m i :=
      Ideal.le_of_dvd (Finset.dvd_prod_of_mem _ hi)
    exact hle (by rw [hg]; exact Ideal.mem_span_singleton_self _)
  have hpα : p.eval (α i) = y i ^ 2 := by
    have := (equation_iff _ _).mp (h i).1
    simp only [WK] at this
    rw [hpC]
    simp only [eval_add, eval_mul, eval_pow, eval_C, eval_X]
    linear_combination -this
  exact locVal_dvd_of_mem a₂ a₄ a₆ pC hpC (α i) (y i) (m i) (hy i hi) hpα hm A B hmem

include hpC in
/-- `exists_localK` for any curve equal to `⟨0, a₂, 0, a₄, a₆⟩`. -/
theorem exists_localW (W' : WeierstrassCurve K) (hW : W' = ⟨0, a₂, 0, a₄, a₆⟩)
    (hsq : Squarefree (CPoly.toPoly pC)) {ι' : Type*}
    (s : Finset ι') (α y : ι' → K) (h : ∀ i, W'.toAffine.Nonsingular (α i) (y i))
    (hy : ∀ i ∈ s, y i ≠ 0) (m : ι' → ℕ)
    (hsum : ∑ i ∈ s, m i • (Point.some _ _ (h i) : W'.toAffine.Point) = 0) :
    ∃ A B : K[X], (A ≠ 0 ∨ B ≠ 0) ∧ 2 * A.natDegree ≤ ∑ i ∈ s, m i ∧
      (B = 0 ∨ 2 * B.natDegree + 3 ≤ ∑ i ∈ s, m i) ∧
      ∀ i ∈ s, 1 ≤ m i → X ^ m i ∣ locVal pC A B (α i, y i, m i) := by
  subst hW
  exact exists_localK a₂ a₄ a₆ pC hpC hsq s α y h hy m hsum

end Gen

variable (a b c : ℤ)

/-- The curve over `ℚ`. -/
abbrev WQ : WeierstrassCurve.Affine ℚ := (EllNL.W a b c).toAffine

/-- **Existence of `u = A + B y`** over `ℚ`. -/
theorem exists_local [DecidableEq ℚ] (hsq : Squarefree (CPoly.toPoly (pOf a b c))) {ι' : Type*}
    (s : Finset ι') (α y : ι' → ℚ) (h : ∀ i, (WQ a b c).Nonsingular (α i) (y i))
    (hy : ∀ i ∈ s, y i ≠ 0) (m : ι' → ℕ)
    (hsum : ∑ i ∈ s, m i • (Point.some _ _ (h i) : (WQ a b c).Point) = 0) :
    ∃ A B : ℚ[X], (A ≠ 0 ∨ B ≠ 0) ∧ 2 * A.natDegree ≤ ∑ i ∈ s, m i ∧
      (B = 0 ∨ 2 * B.natDegree + 3 ≤ ∑ i ∈ s, m i) ∧
      ∀ i ∈ s, 1 ≤ m i → X ^ m i ∣ locVal (pOf a b c) A B (α i, y i, m i) :=
  exists_localK (a : ℚ) b c (pOf a b c) (toPoly_pOf a b c) hsq s α y h hy m hsum

end EllAlgo
