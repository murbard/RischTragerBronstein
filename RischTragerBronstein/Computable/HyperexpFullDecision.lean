import RischTragerBronstein.Computable.HyperexpResidueStrong
import RischTragerBronstein.Computable.HyperexpLaurent
import RischTragerBronstein.Liouville.ResidueTestSufficient

/-!
# The full decision for one hyperexponential over `R(x)`

`K = R(x)(t)`, `t′ = η t`, `η = Gn / Gd ∈ R(x)` in lowest terms, without simple poles,
`deg Gn + 1 ≠ deg Gd` — in particular `t = exp a(x)` for a nonconstant **rational** function `a`. After splitting off the powers of `t` in the
denominator and Hermite reduction, every `f ∈ K` has the form

  `f = g′ + (f₀ + ∑_{j < N, j ≠ n} fⱼ(x) t ^ j / t ^ n) + b(t) / sd(t)`,

`sd` squarefree, `t ∤ sd`, `deg b < deg sd`. `expFull_decides`: `f` has an elementary integral **iff**
the residue test passes and every Risch differential equation `y′ + (j - n) a′ y = fⱼ`, `j ≠ n`, is
solvable in `R(x)` (`rdeRational`). No assumption on constants.
-/

open Polynomial IntermediateField

set_option linter.unusedSectionVars false

namespace CPoly

open Differential

universe u

variable {R F₀ : Type*} {K : Type u} [Field R] [DecidableEq R] [CharZero R] [Field F₀] [Field K]
variable [Algebra R F₀] [Algebra F₀ K] [Algebra R K] [IsScalarTower R F₀ K]
variable [Differential F₀] [Differential K] [DifferentialAlgebra F₀ K] [CharZero K]

theorem hyperexpFull_decides (hR : ∀ r : R, (algebraMap R F₀ r)′ = 0)
    (x₀ : F₀) (hx₀ : x₀′ = 1) (hgen₀ : adjoin R {x₀} = (⊤ : IntermediateField R F₀))
    (t : K) (hgen : adjoin F₀ {t} = (⊤ : IntermediateField F₀ K))
    (ht0 : t ≠ 0) (Gn Gd G₁ : CPoly R)
    (hGn0 : toPoly Gn ≠ 0) (hGd0 : toPoly Gd ≠ 0) (hcop : IsCoprime (toPoly Gn) (toPoly Gd))
    (hr1 : toPoly G₁ ∣ toPoly Gd) (hr2 : toPoly G₁ ∣ derivative (toPoly Gd))
    (hr3 : toPoly Gd ∣ toPoly G₁ ^ 2)
    (hdegη : (toPoly Gn).natDegree + 1 ≠ (toPoly Gd).natDegree)
    (ht : t′ = algebraMap F₀ K (aeval x₀ (toPoly Gn) / aeval x₀ (toPoly Gd)) * t)
    (g : K) (N n : ℕ) (A D : ℕ → CPoly R) (A₀ D₀ : CPoly R) (hD₀ : toPoly D₀ ≠ 0)
    (hD0 : ∀ j < N, toPoly (D j) ≠ 0)
    (b sd r : F₀[X]) (hsd : Squarefree sd) (hX : ¬X ∣ sd) (hdeg : b.degree < sd.degree)
    (hst : aeval t sd ≠ 0)
    (hr : sd ∣ r * (mapCoeffs sd +
      C (aeval x₀ (toPoly Gn) / aeval x₀ (toPoly Gd)) * X * derivative sd) - b) :
    HasElementaryIntegral (g′ +
        (aeval (algebraMap F₀ K x₀) (toPoly A₀) / aeval (algebraMap F₀ K x₀) (toPoly D₀) +
          ∑ j ∈ (Finset.range N).erase n,
            aeval (algebraMap F₀ K x₀) (toPoly (A j)) /
              aeval (algebraMap F₀ K x₀) (toPoly (D j)) * t ^ j / t ^ n) +
        aeval t b / aeval t sd) ↔
      sd ∣ residueTest r sd ∧ ∀ j < N, j ≠ n →
        (rdeRationalG (smul (((j : ℤ) - n : ℤ) : R) Gn) Gd (A j) (D j)).isSome = true := by
  classical
  have hcharF₀ : CharZero F₀ := charZero_of_injective_algebraMap (algebraMap R F₀).injective
  set x : K := algebraMap F₀ K x₀ with hx
  have hx' : x′ = 1 := by rw [hx, deriv_algebraMap, hx₀, map_one]
  have hRK : ∀ r : R, (algebraMap R K r)′ = 0 := fun r ↦ by
    rw [IsScalarTower.algebraMap_apply R F₀ K, deriv_algebraMap, hR, map_zero]
  let _ : Differential R := ⟨0⟩
  have h0 : ∀ r : R, r′ = 0 := fun _ ↦ rfl
  have hDAR : DifferentialAlgebra R K := ⟨fun r ↦ by rw [hRK, h0, map_zero]⟩
  have haevx : ∀ P : R[X], aeval x P = algebraMap F₀ K (aeval x₀ P) := fun P ↦
    aeval_algebraMap_apply K x₀ P
  have ht' : t′ = aeval x (toPoly Gn) / aeval x (toPoly Gd) * t := by
    rw [ht, map_div₀, haevx, haevx]
  -- `K` is generated by `x` and `t` over `R`
  have hgenK : adjoin R {x, t} = (⊤ : IntermediateField R K) := by
    set N₁ : IntermediateField R K := adjoin R {x, t} with hN
    have hxN : x ∈ N₁ := subset_adjoin R _ (Set.mem_insert _ _)
    have htN : t ∈ N₁ := subset_adjoin R _ (Set.mem_insert_of_mem _ rfl)
    have hF₀N : ∀ f : F₀, algebraMap F₀ K f ∈ N₁ := by
      let T₀ : IntermediateField R F₀ := N₁.comap (IsScalarTower.toAlgHom R F₀ K)
      have hT₀ : T₀ = ⊤ := by
        rw [eq_top_iff, ← hgen₀, adjoin_le_iff]
        rintro k rfl
        exact hxN
      intro f
      have : f ∈ T₀ := hT₀ ▸ IntermediateField.mem_top
      exact this
    let N' : IntermediateField F₀ K := { N₁.toSubfield with algebraMap_mem' := hF₀N }
    have hN' : N' = ⊤ := by
      rw [eq_top_iff, ← hgen, adjoin_le_iff]
      rintro k rfl
      exact htN
    rw [eq_top_iff]
    intro k _
    have : k ∈ N' := hN' ▸ IntermediateField.mem_top
    exact this
  set Lsum : K := aeval x (toPoly A₀) / aeval x (toPoly D₀) +
    ∑ j ∈ (Finset.range N).erase n,
      aeval x (toPoly (A j)) / aeval x (toPoly (D j)) * t ^ j / t ^ n with hLsum
  -- the Laurent part as `Λ / t ^ n`, `Λ ∈ F₀[X]`
  set Λ : F₀[X] := C (aeval x₀ (toPoly A₀) / aeval x₀ (toPoly D₀)) * X ^ n +
    ∑ j ∈ (Finset.range N).erase n,
      C (aeval x₀ (toPoly (A j)) / aeval x₀ (toPoly (D j))) * X ^ j with hΛ
  have htn : t ^ n ≠ 0 := pow_ne_zero _ ht0
  have hΛv : aeval t Λ / t ^ n = Lsum := by
    simp only [hΛ, hLsum, map_add, map_sum, map_mul, map_pow, aeval_C, aeval_X, haevx, map_div₀]
    rw [add_div, Finset.sum_div, mul_div_assoc, div_self htn, mul_one]
  set η₀ : F₀ := aeval x₀ (toPoly Gn) / aeval x₀ (toPoly Gd) with hη₀
  have hlogIn : sd ∣ residueTest r sd → HasElementaryIntegralIn (aeval t b / aeval t sd) :=
    fun hT ↦ hasElementaryIntegralIn_of_residueTest t 0 η₀
      (by rw [ht, map_zero, zero_add]) t ht0
      (by rw [logDeriv, ht, mul_div_assoc, div_self ht0, mul_one])
      sd b r (PerfectField.separable_iff_squarefree.mpr hsd) hst hdeg
      (by rwa [C_0, zero_add]) hT
  constructor
  · intro hf
    have h1 : HasElementaryIntegral (Lsum + aeval t b / aeval t sd) := by
      have := hf.sub_in (hasElementaryIntegralIn_deriv g)
      have heq : g′ + Lsum + aeval t b / aeval t sd - g′ = Lsum + aeval t b / aeval t sd := by
        ring
      rwa [heq] at this
    have hT : sd ∣ residueTest r sd := by
      by_contra hT
      refine not_hasElementaryIntegral_hyperexpResidue hR x₀ hx₀ hgen₀ t hgen ht0 Gn Gd G₁ hGn0 hGd0 hcop
        hr1 hr2 hr3 hdegη ht
        (Λ * sd + b * X ^ n) b sd r n hsd hX ⟨Λ, by ring⟩ hr hT ?_
      have : aeval t (Λ * sd + b * X ^ n) / (aeval t sd * t ^ n) =
          aeval t Λ / t ^ n + aeval t b / aeval t sd := by
        rw [map_add, map_mul, map_mul, map_pow, aeval_X]
        field_simp
      rw [this, hΛv]
      exact h1
    refine ⟨hT, fun j hj hjn ↦ ?_⟩
    have h2 : HasElementaryIntegral Lsum := by
      have := h1.sub_in (hlogIn hT)
      rwa [add_sub_cancel_right] at this
    by_contra hnone
    rw [Bool.not_eq_true, Option.isSome_eq_false_iff, Option.isNone_iff_eq_none] at hnone
    exact not_hasElementaryIntegral_hyperexpLaurent hRK x t hx' ht0 Gn Gd G₁ ht' hgenK hGn0 hGd0
      hcop hr1 hr2 hr3 hdegη N n A D A₀ D₀ hD0
      j hj hjn hnone h2
  · rintro ⟨hT, hsome⟩
    have hYG : ∀ j, ∃ Y G : CPoly R, j < N → j ≠ n →
        rdeRationalG (smul (((j : ℤ) - n : ℤ) : R) Gn) Gd (A j) (D j) = some (Y, G) := fun j ↦ by
      by_cases h : j < N ∧ j ≠ n
      · obtain ⟨p, hp⟩ := Option.isSome_iff_exists.mp (hsome j h.1 h.2)
        exact ⟨p.1, p.2, fun _ _ ↦ hp⟩
      · exact ⟨[], [], fun h1 h2 ↦ absurd ⟨h1, h2⟩ h⟩
    choose Y G hYG using hYG
    have hL : HasElementaryIntegral Lsum :=
      hasElementaryIntegral_hyperexpLaurent h0 x t hx' ht0 Gn Gd hGd0 ht' N n A D Y G A₀ D₀ hD₀
        hD0 hYG
    have := ((hL.add_in (hlogIn hT)).add_in (hasElementaryIntegralIn_deriv g))
    have heq : g′ + Lsum + aeval t b / aeval t sd = Lsum + aeval t b / aeval t sd + g′ := by
      ring
    rwa [heq]

end CPoly
