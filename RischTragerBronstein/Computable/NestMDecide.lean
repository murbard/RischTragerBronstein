import RischTragerBronstein.Computable.NestMElem

/-!
# Towers of nested exponentials: the decision theorem

`nestM_decides`: let `E = Kc(x, t₀, …, t_{n-1})` be generated by a tower of exponentials with nested
data (`tₘ = exp aₘ`, `aₘ ∈ Kₘ = Kc(x, t₀, …, t_{m-1})`, `Kc ⊇` all constants — e.g. `eˣ`,
`exp(eˣ)`, `e^{x²}`) and suppose the tower certificate `expCertM` holds (each `aₘ` is not a
rational combination of the previous exponents modulo constants, checked by a constant system).
Then for every code `A`: `A` has an elementary integral over `E` ↔ `elemNM (expK as) n A = true`.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false

namespace Tower.NestM

open Tower.PrimN Tower.NestP

universe u v

namespace NestMTower

variable {Kc : Type*} {E : Type u} [Field Kc] [Field E] [Algebra Kc E] [Differential Kc]
variable [Differential E] [DifferentialAlgebra Kc E] [CharZero Kc] {as : (m : ℕ) → Code (m + 1)}
variable (T : NestMTower Kc E (expK as))

lemma x_mem (m : ℕ) : T.x ∈ T.F m :=
  T.F_mono (Nat.zero_le m) (mem_adjoin_simple_self Kc T.x)

variable {Kc' : Type*} {L : Type v} [Field Kc'] [Field L] [Algebra Kc' L] [Differential Kc']
variable [Differential L] [DifferentialAlgebra Kc' L] [CharZero Kc']
  (T' : NestMTower Kc' L (expK as))

/-- `j` maps each level into the corresponding level. -/
theorem map_mem_F (j : E →+* L) (hj : ∀ z : E, (j z)′ = j z′) (hx : T'.x = j T.x)
    (hts : ∀ i, T'.ts i = j (T.ts i)) : ∀ (m : ℕ) (z : E), z ∈ T.F m → j z ∈ T'.F m
  | 0, z, hz => by
    let S : IntermediateField Kc E :=
      { carrier := {w | j w ∈ T'.F 0}
        mul_mem' := fun {a b} ha hb ↦ by
          change j (a * b) ∈ T'.F 0; rw [map_mul]; exact mul_mem ha hb
        one_mem' := by change j 1 ∈ T'.F 0; rw [map_one]; exact one_mem _
        add_mem' := fun {a b} ha hb ↦ by
          change j (a + b) ∈ T'.F 0; rw [map_add]; exact add_mem ha hb
        zero_mem' := by change j 0 ∈ T'.F 0; rw [map_zero]; exact zero_mem _
        algebraMap_mem' := fun c ↦ T'.const_memM 0 _ (by
          rw [hj, deriv_algebraMap, T.hC, map_zero, map_zero])
        inv_mem' := fun a ha ↦ by
          change j a⁻¹ ∈ T'.F 0; rw [map_inv₀]; exact inv_mem ha }
    have hle : Kc⟮T.x⟯ ≤ S := by
      rw [adjoin_simple_le_iff]
      change j T.x ∈ T'.F 0
      rw [← hx]
      exact T'.x_mem 0
    exact hle hz
  | m + 1, z, hz => by
    have ih := map_mem_F j hj hx hts m
    let S : IntermediateField (T.F m) E :=
      { carrier := {w | j w ∈ T'.F (m + 1)}
        mul_mem' := fun {a b} ha hb ↦ by
          change j (a * b) ∈ T'.F (m + 1); rw [map_mul]; exact mul_mem ha hb
        one_mem' := by change j 1 ∈ T'.F (m + 1); rw [map_one]; exact one_mem _
        add_mem' := fun {a b} ha hb ↦ by
          change j (a + b) ∈ T'.F (m + 1); rw [map_add]; exact add_mem ha hb
        zero_mem' := by change j 0 ∈ T'.F (m + 1); rw [map_zero]; exact zero_mem _
        algebraMap_mem' := fun a ↦ T'.le_succ m (ih a a.2)
        inv_mem' := fun a ha ↦ by
          change j a⁻¹ ∈ T'.F (m + 1); rw [map_inv₀]; exact inv_mem ha }
    have hle : (T.F m)⟮T.ts m⟯ ≤ S := by
      rw [adjoin_simple_le_iff]
      change j (T.ts m) ∈ T'.F (m + 1)
      rw [← hts]
      exact T'.ts_mem m
    exact hle ((T.mem_F_succ).mp hz)

lemma sC_single (m : ℕ) (h : T.Tr m) (A : Code (m + 1)) :
    sC (algebraMap Kc (T.F m)) (T.MP m h) [1] [A] = (T.MP m h).sem A := by
  simp [sC]

lemma sQ_single (m : ℕ) (h : T.Tr m) (β : List ℚ) (A : Code (m + 1)) :
    sQ (T.MP m h) β [A] = ((β.getD 0 0 : ℚ) : T.F m) * (T.MP m h).sem A := by
  simp [sQ]

/-- **Towers of nested exponentials are decided**, for every height `n`: when `E` is generated by
`x, t₀, …, t_{n-1}` over its constants and the certificate holds, a code `A` has an elementary
integral over `E` if and only if `elemNM (expK as) n A = true`. -/
theorem nestM_decides (n : ℕ) (hgen : T.F n = ⊤) (hcert : expCertM (expK as) n = true)
    (A : Code (n + 1)) :
    HasElementaryIntegral ((((T.MP n (T.tr_of_expCert n hcert)).sem A : T.F n)) : E) ↔
      elemNM (expK as) n A = true := by
  have : CharZero E := charZero_of_injective_algebraMap (algebraMap Kc E).injective
  constructor
  · rintro ⟨L, _, _, _, _, hE, g, hg⟩
    have : CharZero L := charZero_of_injective_algebraMap (algebraMap E L).injective
    -- the constants of `L`
    let Cc := constants L
    let _ : Differential Cc := ⟨0⟩
    have hDAc : DifferentialAlgebra Cc L := ⟨fun c ↦ c.2⟩
    have hcharC : CharZero Cc := ⟨fun a b h ↦ by
      have := congrArg (fun z : Cc ↦ (z : L)) h
      simpa using this⟩
    set j := algebraMap E L with hjdef
    have hj : ∀ z : E, (j z)′ = j z′ := fun z ↦ deriv_algebraMap z
    -- the same tower inside `L`
    let T' : NestMTower Cc L (expK as) :=
      { x := j T.x
        ts := fun i ↦ j (T.ts i)
        hC := fun _ ↦ rfl
        hx := by rw [hj, T.hx, map_one]
        ht := fun m ↦ by
          change (j (T.ts m))′ = (evN Cc (j T.x) (fun i ↦ j (T.ts i)) m (as m))′ * j (T.ts m)
          rw [hj, T.ht m]
          change j ((evN Kc T.x T.ts m (as m))′ * T.ts m) = _
          rw [map_mul, ← hj, map_evN (Kc := Kc) (Cc := Cc)]
        hts0 := fun m a hk ↦ by
          have := T.hts0 m a hk
          exact (map_ne_zero j).mpr this
        hCall := fun z hz ↦ ⟨⟨z, hz⟩, rfl⟩ }
    have htrans : (((T'.MP n (T'.tr_of_expCert n hcert)).sem A : T'.F n) : L) =
        j (((T.MP n (T.tr_of_expCert n hcert)).sem A : T.F n) : E) := by
      rw [T'.sem_MP, T.sem_MP, map_evN (Kc := Kc) (Cc := Cc)]
    -- the strong Liouville theorem
    obtain ⟨ι, s, c, u, v, hdata, hv, heq⟩ := liouville_strong hE _ g hg
    have hcf : ∀ z ∈ constField E L, z ∈ T'.F n := by
      let N : IntermediateField E L :=
        { (T'.F n).toSubfield with
          algebraMap_mem' := fun e ↦ T.map_mem_F T' j hj rfl (fun _ ↦ rfl) n e
            (by rw [hgen]; trivial) }
      have : constField E L ≤ N := adjoin_le_iff.mpr fun z hz ↦ T'.const_memM n z hz
      exact fun z hz ↦ this hz
    have hspec := T'.paramElemM_spec n hcert (T'.tr_of_expCert n hcert)
    obtain ⟨γ, hγ⟩ := hspec.complete [A] [1] (fun k hk ↦ by
      rcases k with _ | k
      · simp at hk
      · rfl) (by
        rw [T'.sC_single, htrans]
        exact ⟨ι, s, c, u, v, fun i hi ↦ ⟨(hdata i hi).1, hcf _ (hdata i hi).2.1,
          (hdata i hi).2.2⟩, hcf _ hv, heq⟩)
    have h0 := hγ 0
    by_contra hne
    simp only [elemNM, List.any_eq_true, decide_eq_true_eq, not_exists, not_and, not_not] at hne
    rw [Finset.sum_eq_zero fun k hk ↦ by
      rw [hne _ (NestTower.getD_mem_of_lt _ [] (Finset.mem_range.mp hk)), map_zero, mul_zero]] at h0
    simp at h0
  · intro hel
    simp only [elemNM, List.any_eq_true, decide_eq_true_eq] at hel
    obtain ⟨β, hβ, hβ0⟩ := hel
    have hs := (T.paramElemM_spec n hcert (T.tr_of_expCert n hcert)).sound [A] β hβ
    rw [T.sQ_single, IntermediateField.coe_mul] at hs
    have hc : (((β.getD 0 0 : ℚ) : T.F n) : E) = ((β.getD 0 0 : ℚ) : E) := by simp
    rw [hc] at hs
    have hd : (((β.getD 0 0 : ℚ)⁻¹ : ℚ) : E)′ = 0 := by
      rw [← map_ratCast (algebraMap Kc E), deriv_algebraMap, T.hC, map_zero]
    have := (hs.const_mul _ hd).hasElementaryIntegral
    convert this using 1
    rw [← mul_assoc, ← Rat.cast_mul, inv_mul_cancel₀ hβ0, Rat.cast_one, one_mul]

end NestMTower

end Tower.NestM
