import RischTragerBronstein.Computable.NestMDecide

/-!
# Towers of nested exponentials: examples

In any differential field `E` generated over its constants by `x`, `t₀ = eˣ`, `t₁ = exp(eˣ)`
(`t₀′ = t₀`, `t₁′ = t₀ t₁`) — `nestM_decides`; certificates and answers are computed by the
kernel:

* `∫ exp(eˣ) dx` is **not** elementary; `∫ eˣ exp(eˣ) dx = exp(eˣ)` is.

In any differential field generated by `x` and `t₀ = e^{x²}` (`t₀′ = 2x t₀`):

* `∫ e^{x²} dx` is **not** elementary; `∫ x e^{x²} dx = e^{x²}/2` is.
-/

open Differential

namespace Tower.NestM.Examples

open Tower.PrimN Tower.NestP

def r (n d : CPoly ℚ) : Code 1 := (n, d)
def one₁ : Code 1 := r [1] [1]
def zero₁ : Code 1 := r [] [1]
def one₂ : Code 2 := ([one₁], [one₁])
def zero₂ : Code 2 := ([], [one₁])
/-- `t₀`. -/
def T0 : Code 2 := ([zero₁, one₁], [one₁])
/-- `x t₀`. -/
def xT0 : Code 2 := ([zero₁, r [0, 1] [1]], [one₁])
/-- `t₁`. -/
def T1 : Code 3 := ([zero₂, one₂], [one₂])
/-- `t₀ t₁`. -/
def T0T1 : Code 3 := ([zero₂, T0], [one₂])

/-- `t₀ = eˣ`, `t₁ = exp(eˣ)` (higher levels unused). -/
def asE : (m : ℕ) → Code (m + 1)
  | 0 => r [0, 1] [1]
  | 1 => T0
  | m + 2 => ([], [oneC (m + 2)])

/-- `t₀ = e^{x²}` (higher levels unused). -/
def asG : (m : ℕ) → Code (m + 1)
  | 0 => r [0, 0, 1] [1]
  | m + 1 => ([], [oneC (m + 1)])

set_option maxRecDepth 100000

theorem certE : expCertM (expK asE) 2 = true := by decide +kernel
theorem certG : expCertM (expK asG) 1 = true := by decide +kernel

variable {Kc E : Type*} [Field Kc] [Field E] [Algebra Kc E] [Differential Kc] [Differential E]
variable [DifferentialAlgebra Kc E] [CharZero Kc]

lemma val_T1 (T : NestMTower Kc E (expK asE)) (h : T.Tr 2) :
    (((T.MP 2 h).sem T1 : T.F 2) : E) = T.ts 1 := by
  refine (T.sem_MP 2 h _).trans ?_
  simp [evN, PrimN.evx, T1, one₂, zero₂, one₁, zero₁, r, CPoly.toPoly, List.foldr]

lemma val_T0T1 (T : NestMTower Kc E (expK asE)) (h : T.Tr 2) :
    (((T.MP 2 h).sem T0T1 : T.F 2) : E) = T.ts 0 * T.ts 1 := by
  refine (T.sem_MP 2 h _).trans ?_
  simp [evN, PrimN.evx, T0T1, T0, one₂, zero₂, one₁, zero₁, r, CPoly.toPoly, List.foldr, mul_comm]

lemma val_T0 (T : NestMTower Kc E (expK asG)) (h : T.Tr 1) :
    (((T.MP 1 h).sem T0 : T.F 1) : E) = T.ts 0 := by
  refine (T.sem_MP 1 h _).trans ?_
  simp [evN, PrimN.evx, T0, one₁, zero₁, r, CPoly.toPoly, List.foldr]

lemma val_xT0 (T : NestMTower Kc E (expK asG)) (h : T.Tr 1) :
    (((T.MP 1 h).sem xT0 : T.F 1) : E) = T.x * T.ts 0 := by
  refine (T.sem_MP 1 h _).trans ?_
  simp [evN, PrimN.evx, xT0, one₁, zero₁, r, CPoly.toPoly, List.foldr, mul_comm]

/-- **`∫ exp(eˣ) dx` is not elementary.** -/
theorem exp_exp_not_elementary (T : NestMTower Kc E (expK asE)) (hgen : T.F 2 = ⊤) :
    ¬HasElementaryIntegral (T.ts 1) := by
  rw [← val_T1 T (T.tr_of_expCert 2 certE)]
  exact fun h ↦ absurd ((T.nestM_decides 2 hgen certE _).mp h) (by decide +kernel)

/-- `∫ eˣ exp(eˣ) dx = exp(eˣ)`: the algorithm answers yes. -/
theorem exp_exp_deriv_elementary (T : NestMTower Kc E (expK asE)) (hgen : T.F 2 = ⊤) :
    HasElementaryIntegral (T.ts 0 * T.ts 1) := by
  rw [← val_T0T1 T (T.tr_of_expCert 2 certE)]
  exact (T.nestM_decides 2 hgen certE _).mpr (by decide +kernel)

/-- **`∫ e^{x²} dx` is not elementary.** -/
theorem gauss_not_elementary (T : NestMTower Kc E (expK asG)) (hgen : T.F 1 = ⊤) :
    ¬HasElementaryIntegral (T.ts 0) := by
  rw [← val_T0 T (T.tr_of_expCert 1 certG)]
  exact fun h ↦ absurd ((T.nestM_decides 1 hgen certG _).mp h) (by decide +kernel)

/-- `∫ x e^{x²} dx = e^{x²}/2`: the algorithm answers yes. -/
theorem x_gauss_elementary (T : NestMTower Kc E (expK asG)) (hgen : T.F 1 = ⊤) :
    HasElementaryIntegral (T.x * T.ts 0) := by
  rw [← val_xT0 T (T.tr_of_expCert 1 certG)]
  exact (T.nestM_decides 1 hgen certG _).mpr (by decide +kernel)

end Tower.NestM.Examples
