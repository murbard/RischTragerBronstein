import RischTragerBronstein.Computable.NestPElem
import RischTragerBronstein.Computable.MixNDecide

/-!
# Towers of nested primitives: the decision theorem

`nestN_decides`: let `E = Kc(x, t₀, …, t_{n-1})` be generated by a tower of primitives with nested
data (`tₘ′ = ηₘ ∈ Kₘ = Kc(x, t₀, …, t_{m-1})`, `Kc ⊇` all constants — e.g. `log x`, `log log x`,
`li`-type towers) and suppose `nestCert ηs n` holds (no `ηₘ` is a derivative in `Kₘ`, checked by
parametric limited integration). Then for every code `A`:
`A` has an elementary integral over `E` ↔ `elemN ηs n A = true`.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false


namespace Tower.NestP

open Tower.PrimN

universe u v

lemma map_evN {Kc Cc E L : Type*} [Field Kc] [Field Cc] [Field E] [Field L] [Algebra Kc E]
    [Algebra Cc L] [CharZero Kc] [CharZero Cc] [CharZero E] [CharZero L] (j : E →+* L) (x : E)
    (ts : ℕ → E) : ∀ (m : ℕ) (q : Code (m + 1)),
      j (evN Kc x ts m q) = evN Cc (j x) (fun i ↦ j (ts i)) m q
  | 0, q => Tower.MixN.map_evx j x q
  | m + 1, q => by
    have hf : ∀ l : List (Code (m + 1)),
        j (l.foldr (fun a acc ↦ evN Kc x ts m a + ts m * acc) 0) =
          l.foldr (fun a acc ↦ evN Cc (j x) (fun i ↦ j (ts i)) m a + j (ts m) * acc) 0 := by
      intro l
      induction l with
      | nil => simp
      | cons a l ih => rw [List.foldr_cons, List.foldr_cons, map_add, map_mul, ih, map_evN (Kc := Kc) (Cc := Cc) j x ts m a]
    simp only [evN, map_div₀, hf]

namespace NestTower

variable {Kc : Type*} {E : Type u} [Field Kc] [Field E] [Algebra Kc E] [Differential Kc]
variable [Differential E] [DifferentialAlgebra Kc E] [CharZero Kc] {ηs : (m : ℕ) → Code (m + 1)}
variable (T : NestTower Kc E ηs)

/-- No `ηᵢ` (`i < m`) is a derivative in `F i`. -/
def ND (m : ℕ) : Prop := ∀ i < m, ∀ y : T.F i, y′ ≠ T.valN i (ηs i)

lemma tr_of_ND {m : ℕ} (h : T.ND m) : T.Tr m := fun i hi ↦
  transcendental_primitive (T.valN i (ηs i)) (T.ht i) (h i hi)

/-- **The certificate proves the tower**: each `ηₘ` (`m < n`) is not a derivative in `F m`. -/
theorem nd_of_nestCert : ∀ n : ℕ, nestCert ηs n = true → T.ND n
  | 0, _ => fun i hi ↦ absurd hi (Nat.not_lt_zero i)
  | n + 1, h => by
    have h' : nestCert ηs n = true ∧
        ((paramLim ηs n [ηs n]).all fun r ↦ r.1.getD 0 0 == 0) = true := by
      simp only [nestCert, List.range_succ, List.all_append, List.all_cons, List.all_nil,
        Bool.and_true, Bool.and_eq_true] at h
      exact h
    have hnd := nd_of_nestCert n h'.1
    intro i hi
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · exact hnd i hi
    · intro y hy
      have hspec := (T.paramLim_spec i (T.tr_of_ND hnd) hnd [ηs i]).2
      obtain ⟨β, hβ, -⟩ := hspec [1] (fun k hk ↦ by
        rcases k with _ | k
        · simp at hk
        · rfl) y (by
          rw [hy]
          simp [sumK, zc, T.sem_MP_F])
      have h0 := hβ 0
      rw [Finset.sum_eq_zero fun k hk ↦ ?_] at h0
      · simp at h0
      · have hmem := List.all_eq_true.mp h'.2 _ (getD_mem_of_lt _ ([], zc ηs i)
          (Finset.mem_range.mp hk))
        rw [beq_iff_eq] at hmem
        rw [hmem, map_zero, mul_zero]

lemma x_mem (m : ℕ) : T.x ∈ T.F m :=
  T.F_mono (Nat.zero_le m) (mem_adjoin_simple_self Kc T.x)

variable {Kc' : Type*} {L : Type v} [Field Kc'] [Field L] [Algebra Kc' L] [Differential Kc']
variable [Differential L] [DifferentialAlgebra Kc' L] [CharZero Kc'] (T' : NestTower Kc' L ηs)

/-- `j` maps each level into the corresponding level. -/
theorem map_mem_F (j : E →+* L) (hj : ∀ z : E, (j z)′ = j z′) (hx : T'.x = j T.x)
    (hts : ∀ i, T'.ts i = j (T.ts i)) : ∀ (m : ℕ) (z : E), z ∈ T.F m → j z ∈ T'.F m
  | 0, z, hz => by
    let S : IntermediateField Kc E :=
      { carrier := {w | j w ∈ T'.F 0}
        mul_mem' := fun {a b} ha hb ↦ by
          change j (a * b) ∈ T'.F 0; rw [map_mul]; exact mul_mem ha hb
        one_mem' := by change j 1 ∈ T'.F 0; rw [map_one]; exact one_mem _
        add_mem' := fun {a b} ha hb ↦ by
          change j (a + b) ∈ T'.F 0; rw [map_add]; exact add_mem ha hb
        zero_mem' := by change j 0 ∈ T'.F 0; rw [map_zero]; exact zero_mem _
        algebraMap_mem' := fun c ↦ T'.const_mem 0 _ (by
          rw [hj, deriv_algebraMap, T.hC, map_zero, map_zero])
        inv_mem' := fun a ha ↦ by
          change j a⁻¹ ∈ T'.F 0; rw [map_inv₀]; exact inv_mem ha }
    have hle : Kc⟮T.x⟯ ≤ S := by
      rw [adjoin_simple_le_iff]
      change j T.x ∈ T'.F 0
      rw [← hx]
      exact T'.x_mem 0
    exact hle hz
  | m + 1, z, hz => by
    have ih := map_mem_F j hj hx hts m
    let S : IntermediateField (T.F m) E :=
      { carrier := {w | j w ∈ T'.F (m + 1)}
        mul_mem' := fun {a b} ha hb ↦ by
          change j (a * b) ∈ T'.F (m + 1); rw [map_mul]; exact mul_mem ha hb
        one_mem' := by change j 1 ∈ T'.F (m + 1); rw [map_one]; exact one_mem _
        add_mem' := fun {a b} ha hb ↦ by
          change j (a + b) ∈ T'.F (m + 1); rw [map_add]; exact add_mem ha hb
        zero_mem' := by change j 0 ∈ T'.F (m + 1); rw [map_zero]; exact zero_mem _
        algebraMap_mem' := fun a ↦ T'.le_succ m (ih a a.2)
        inv_mem' := fun a ha ↦ by
          change j a⁻¹ ∈ T'.F (m + 1); rw [map_inv₀]; exact inv_mem ha }
    have hle : (T.F m)⟮T.ts m⟯ ≤ S := by
      rw [adjoin_simple_le_iff]
      change j (T.ts m) ∈ T'.F (m + 1)
      rw [← hts]
      exact T'.ts_mem m
    exact hle ((T.mem_F_succ).mp hz)

lemma sumK_single (m : ℕ) (h : T.Tr m) (A : Code (m + 1)) :
    T.sumK m h [1] [A] = (T.MP m h).sem A := by
  simp [sumK]

lemma sumQ_single (m : ℕ) (h : T.Tr m) (β : List ℚ) (A : Code (m + 1)) :
    T.sumQ m h β [A] = ((β.getD 0 0 : ℚ) : T.F m) * (T.MP m h).sem A := by
  simp [sumQ]

/-- **Towers of nested primitives are decided**, for every height `n`: when `E` is generated by
`x, t₀, …, t_{n-1}` over its constants and the certificate holds, a code `A` has an elementary
integral over `E` if and only if `elemN ηs n A = true`. -/
theorem nestN_decides (n : ℕ) (hgen : T.F n = ⊤) (hcert : nestCert ηs n = true)
    (A : Code (n + 1)) :
    HasElementaryIntegral ((((T.MP n (T.tr_of_ND (T.nd_of_nestCert n hcert))).sem A : T.F n)) :
      E) ↔ elemN ηs n A = true := by
  have : CharZero E := charZero_of_injective_algebraMap (algebraMap Kc E).injective
  have hnd := T.nd_of_nestCert n hcert
  constructor
  · rintro ⟨L, _, _, _, _, hE, g, hg⟩
    have : CharZero L := charZero_of_injective_algebraMap (algebraMap E L).injective
    -- the constants of `L`
    let Cc := constants L
    let _ : Differential Cc := ⟨0⟩
    have hDAc : DifferentialAlgebra Cc L := ⟨fun c ↦ c.2⟩
    have hcharC : CharZero Cc := ⟨fun a b h ↦ by
      have := congrArg (fun z : Cc ↦ (z : L)) h
      simpa using this⟩
    set j := algebraMap E L with hjdef
    have hj : ∀ z : E, (j z)′ = j z′ := fun z ↦ deriv_algebraMap z
    -- the same tower inside `L`
    let T' : NestTower Cc L ηs :=
      { x := j T.x
        ts := fun i ↦ j (T.ts i)
        hC := fun _ ↦ rfl
        hx := by rw [hj, T.hx, map_one]
        ht := fun m ↦ by rw [hj, T.ht, map_evN (Kc := Kc) (Cc := Cc)]
        hCall := fun z hz ↦ ⟨⟨z, hz⟩, rfl⟩ }
    have hnd' := T'.nd_of_nestCert n hcert
    have htrans : (((T'.MP n (T'.tr_of_ND hnd')).sem A : T'.F n) : L) =
        j (((T.MP n (T.tr_of_ND hnd)).sem A : T.F n) : E) := by
      rw [T'.sem_MP, T.sem_MP, map_evN (Kc := Kc) (Cc := Cc)]
    -- the strong Liouville theorem
    obtain ⟨ι, s, c, u, v, hdata, hv, heq⟩ := liouville_strong hE _ g hg
    have hcf : ∀ z ∈ constField E L, z ∈ T'.F n := by
      let N : IntermediateField E L :=
        { (T'.F n).toSubfield with
          algebraMap_mem' := fun e ↦ T.map_mem_F T' j hj rfl (fun _ ↦ rfl) n e
            (by rw [hgen]; trivial) }
      have : constField E L ≤ N := adjoin_le_iff.mpr fun z hz ↦ T'.const_mem n z hz
      exact fun z hz ↦ this hz
    have hspec := (T'.paramElem_spec n (T'.tr_of_ND hnd') hnd' [A]).2
    obtain ⟨γ, hγ⟩ := hspec [1] (fun k hk ↦ by
      rcases k with _ | k
      · simp at hk
      · rfl) (by
        rw [T'.sumK_single, htrans]
        exact ⟨ι, s, c, u, v, fun i hi ↦ ⟨(hdata i hi).1, hcf _ (hdata i hi).2.1,
          (hdata i hi).2.2⟩, hcf _ hv, heq⟩)
    have h0 := hγ 0
    by_contra hne
    simp only [elemN, List.any_eq_true, decide_eq_true_eq, not_exists, not_and, not_not] at hne
    rw [Finset.sum_eq_zero fun k hk ↦ by
      rw [hne _ (getD_mem_of_lt _ [] (Finset.mem_range.mp hk)), map_zero, mul_zero]] at h0
    simp at h0
  · intro hel
    simp only [elemN, List.any_eq_true, decide_eq_true_eq] at hel
    obtain ⟨β, hβ, hβ0⟩ := hel
    have hs := (T.paramElem_spec n (T.tr_of_ND hnd) hnd [A]).1 β hβ
    rw [T.sumQ_single, IntermediateField.coe_mul] at hs
    have hc : (((β.getD 0 0 : ℚ) : T.F n) : E) = ((β.getD 0 0 : ℚ) : E) := by simp
    rw [hc] at hs
    have hd : (((β.getD 0 0 : ℚ)⁻¹ : ℚ) : E)′ = 0 := by
      rw [← map_ratCast (algebraMap Kc E), deriv_algebraMap, T.hC, map_zero]
    have := (hs.const_mul _ hd).hasElementaryIntegral
    convert this using 1
    rw [← mul_assoc, ← Rat.cast_mul, inv_mul_cancel₀ hβ0, Rat.cast_one, one_mul]

end NestTower

end Tower.NestP
