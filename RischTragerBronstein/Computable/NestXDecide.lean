import RischTragerBronstein.Computable.NestXElemE
import RischTragerBronstein.Computable.NestXElemP
import RischTragerBronstein.Computable.NestXRde0
import RischTragerBronstein.Computable.NestXRdeEF
import RischTragerBronstein.Computable.NestXRdeP
import RischTragerBronstein.Computable.NestXTransfer

/-!
# Mixed towers of logarithms and exponentials: the decision theorem

`nestX_decides`: let `E = Kc(x, t₀, …, t_{n-1})` be generated by a mixed tower
(`tₘ = log vₘ` with `tₘ′ = ηₘ = vₘ′ / vₘ`, or `tₘ = exp aₘ`, all data in
`Kₘ = Kc(x, t₀, …, t_{m-1})`, `Kc ⊇` all constants) and suppose the tower certificate `certX`
holds. Then for every code `A`: `A` has an elementary integral over `E` ↔ `elemNX ks lv n A = true`.

The proof is a simultaneous induction on the height (`xspecs`): the structure-theorem hypotheses
`MixHyp`, the parametric Risch equation `prdeX` (for every `f = h′ + ∑ cⱼ wⱼ′ / wⱼ` with constant
`cⱼ`), parametric limited integration `paramLimX` and parametric elementary integration
`paramElemX` are all correct at every level.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false

namespace Tower.NestM

open Tower.PrimN Tower.NestP Tower.NestX

universe u v

namespace NestMTower

variable {Kc : Type*} {E : Type u} [Field Kc] [Field E] [Algebra Kc E] [Differential Kc]
variable [Differential E] [DifferentialAlgebra Kc E] [CharZero Kc] {ks : (m : ℕ) → KindN m}
variable (T : NestMTower Kc E ks)

/-- The specifications at height `n`. -/
structure XSpecs (lv : (m : ℕ) → Code (m + 1)) (n : ℕ) : Prop where
  hyp : T.MixHyp n
  rde : ∀ fr : FRep (Code (n + 1)), FRepOK (T.MP n hyp.tr) fr →
    RdeSpecK (algebraMap Kc (T.F n)) (T.MP n hyp.tr) ((T.MP n hyp.tr).sem (fCode (opsM ks n) fr))
      (prdeX ks lv n fr)
  lim : LimSpec (algebraMap Kc (T.F n)) (T.MP n hyp.tr) (paramLimX ks lv n)
  elem : ElemSolSpec (algebraMap Kc (T.F n)) (T.MP n hyp.tr)
    (fun v ↦ HasElementaryIntegralIn (v : E)) (fun v ↦ LiouvilleIn (T.F n) (v : E))
    (paramElemX ks lv n)

/-- The Risch equation `y′ + h′ y = ∑ cᵢ wᵢ` from the specification with `f = h′`. -/
lemma rde_deriv_of {n : ℕ} (h : T.Tr n) (lower : FRep (Code (n + 1)) → List (Code (n + 1)) →
    List (List ℚ × Code (n + 1)))
    (hl : ∀ fr : FRep (Code (n + 1)), FRepOK (T.MP n h) fr →
      RdeSpecK (algebraMap Kc (T.F n)) (T.MP n h) ((T.MP n h).sem (fCode (opsM ks n) fr))
        (lower fr)) (f : Code (n + 1)) :
    RdeSpecK (algebraMap Kc (T.F n)) (T.MP n h) ((T.MP n h).sem f)′ (lower ⟨f, []⟩) := by
  have := hl ⟨f, []⟩ (fun cw hcw ↦ by simp at hcw)
  rwa [sem_fCode, logSumV, List.map_nil, List.sum_nil, add_zero] at this

/-- **All the specifications hold at every certified height.** -/
theorem xspecs (lv : (m : ℕ) → Code (m + 1)) :
    ∀ n, certX ks lv n = true → T.XSpecs lv n
  | 0, _ => ⟨T.mixHyp_zero, fun fr hok ↦ T.prde0X_spec _ fr hok, T.paramLim0X_spec _,
      T.paramElem0X_spec _⟩
  | n + 1, hc => by
    rw [certX_succ, Bool.and_eq_true] at hc
    have IH := xspecs lv n hc.1
    have hM := T.mixHyp_succ lv n IH.hyp IH.lim hc.2
    have hrdeD := T.rde_deriv_of IH.hyp.tr (prdeX ks lv n) IH.rde
    rcases hk : ks n with η | a
    · -- a logarithmic level
      obtain ⟨hv, hlv⟩ := T.certLevel_prim hk IH.hyp.tr hc.2
      have hnd := MixHyp.ndX T hM (Nat.lt_succ_self n) hk hM.tr
      refine ⟨hM, fun fr hok ↦ ?_, ?_, ?_⟩
      · have e : prdeX ks lv (n + 1) fr = prdePrimX ks n η (lv n) (prdeX ks lv n)
            (paramLimX ks lv n) fr := by
          simp only [prdeX, hk]
        rw [e]
        exact T.prdePrimX_spec n hM hk (lv n) hv hlv (prdeX ks lv n) IH.rde (paramLimX ks lv n)
          IH.lim fr hok
      · have e : paramLimX ks lv (n + 1) = primLimStep ks n η (paramLimX ks lv n) := by
          funext W; simp only [paramLimX, hk]
        rw [e]
        exact T.primLimStep_spec n hM.tr hk hnd _ IH.lim
      · have e : paramElemX ks lv (n + 1) =
            primElemStep ks n η (paramLimX ks lv n) (paramElemX ks lv n) := by
          funext W; simp only [paramElemX, hk]
        rw [e]
        exact T.primElemStep_spec n hM.tr hk hnd _ IH.lim _ IH.elem
    · -- an exponential level
      have hc2 := certLevel_exp hk hc.2
      have hhom := MixHyp.homX T hM (Nat.lt_succ_self n) hk hM.tr
      refine ⟨hM, fun fr hok ↦ ?_, ?_, ?_⟩
      · have e : prdeX ks lv (n + 1) fr = prdeExpX ks n a (prdeX ks lv n) fr := by
          simp only [prdeX, hk]
        rw [e]
        exact T.prdeExpX_spec n hM hk hc2 (prdeX ks lv n) IH.rde fr hok
      · have e : paramLimX ks lv (n + 1) =
            expLimStepX ks n a (paramLimX ks lv n) (fun h ↦ prdeX ks lv n ⟨h, []⟩) := by
          funext W; simp only [paramLimX, hk]
        rw [e]
        exact T.expLimStepX_spec n hM.tr hk hhom _ IH.lim _ hrdeD
      · have e : paramElemX ks lv (n + 1) =
            expElemStepX ks n a (paramElemX ks lv n) (fun h ↦ prdeX ks lv n ⟨h, []⟩) := by
          funext W; simp only [paramElemX, hk]
        rw [e]
        exact T.expElemStepX_spec n hM.tr hk hhom _ IH.elem _ hrdeD

lemma sC_singleX (m : ℕ) (h : T.Tr m) (A : Code (m + 1)) :
    sC (algebraMap Kc (T.F m)) (T.MP m h) [1] [A] = (T.MP m h).sem A := by
  simp [sC]

lemma sQ_singleX (m : ℕ) (h : T.Tr m) (β : List ℚ) (A : Code (m + 1)) :
    sQ (T.MP m h) β [A] = ((β.getD 0 0 : ℚ) : T.F m) * (T.MP m h).sem A := by
  simp [sQ]

/-- **Mixed towers of logarithms and exponentials are decided**, for every height `n`: when `E`
is generated by `x, t₀, …, t_{n-1}` over its constants and the certificate holds, a code `A` has
an elementary integral over `E` if and only if `elemNX ks lv n A = true`. -/
theorem nestX_decides (lv : (m : ℕ) → Code (m + 1)) (n : ℕ) (hgen : T.F n = ⊤)
    (hcert : certX ks lv n = true) (A : Code (n + 1)) :
    HasElementaryIntegral ((((T.MP n (T.xspecs lv n hcert).hyp.tr).sem A : T.F n)) : E) ↔
      elemNX ks lv n A = true := by
  have : CharZero E := charZero_of_injective_algebraMap (algebraMap Kc E).injective
  constructor
  · rintro ⟨L, _, _, _, _, hE, g, hg⟩
    have : CharZero L := charZero_of_injective_algebraMap (algebraMap E L).injective
    let Cc := constants L
    let _ : Differential Cc := ⟨0⟩
    have hDAc : DifferentialAlgebra Cc L := ⟨fun c ↦ c.2⟩
    have hcharC : CharZero Cc := ⟨fun a b h ↦ by
      have := congrArg (fun z : Cc ↦ (z : L)) h
      simpa using this⟩
    set j := algebraMap E L with hjdef
    have hj : ∀ z : E, (j z)′ = j z′ := fun z ↦ deriv_algebraMap z
    -- the same tower inside `L`
    let T' : NestMTower Cc L ks :=
      { x := j T.x
        ts := fun i ↦ j (T.ts i)
        hC := fun _ ↦ rfl
        hx := by rw [hj, T.hx, map_one]
        ht := fun m ↦ by
          rw [hj, T.ht m]
          exact map_kder (Kc := Kc) (Cc := Cc) j hj T.x T.ts m (ks m)
        hts0 := fun m a hk ↦ (map_ne_zero j).mpr (T.hts0 m a hk)
        hCall := fun z hz ↦ ⟨⟨z, hz⟩, rfl⟩ }
    have hS' := T'.xspecs lv n hcert
    have htrans : (((T'.MP n hS'.hyp.tr).sem A : T'.F n) : L) =
        j (((T.MP n (T.xspecs lv n hcert).hyp.tr).sem A : T.F n) : E) := by
      rw [T'.sem_MP, T.sem_MP, map_evN (Kc := Kc) (Cc := Cc)]
    obtain ⟨ι, s, c, u, v, hdata, hv, heq⟩ := liouville_strong hE _ g hg
    have hcf : ∀ z ∈ constField E L, z ∈ T'.F n := by
      let N : IntermediateField E L :=
        { (T'.F n).toSubfield with
          algebraMap_mem' := fun e ↦ T.map_mem_FX T' j hj rfl (fun _ ↦ rfl) n e
            (by rw [hgen]; trivial) }
      have : constField E L ≤ N := adjoin_le_iff.mpr fun z hz ↦ T'.const_memX n z hz
      exact fun z hz ↦ this hz
    obtain ⟨γ, hγ⟩ := hS'.elem.complete [A] [1] (fun k hk ↦ by
      rcases k with _ | k
      · simp at hk
      · rfl) (by
        rw [T'.sC_singleX, htrans]
        exact ⟨ι, s, c, u, v, fun i hi ↦ ⟨(hdata i hi).1, hcf _ (hdata i hi).2.1,
          (hdata i hi).2.2⟩, hcf _ hv, heq⟩)
    have h0 := hγ 0
    by_contra hne
    simp only [elemNX, List.any_eq_true, decide_eq_true_eq, not_exists, not_and, not_not] at hne
    rw [Finset.sum_eq_zero fun k hk ↦ by
      rw [hne _ (NestTower.getD_mem_of_lt _ [] (Finset.mem_range.mp hk)), map_zero, mul_zero]] at h0
    simp at h0
  · intro hel
    simp only [elemNX, List.any_eq_true, decide_eq_true_eq] at hel
    obtain ⟨β, hβ, hβ0⟩ := hel
    have hs := (T.xspecs lv n hcert).elem.sound [A] β hβ
    rw [T.sQ_singleX, IntermediateField.coe_mul] at hs
    have hc : (((β.getD 0 0 : ℚ) : T.F n) : E) = ((β.getD 0 0 : ℚ) : E) := by simp
    rw [hc] at hs
    have hd : (((β.getD 0 0 : ℚ)⁻¹ : ℚ) : E)′ = 0 := by
      rw [← map_ratCast (algebraMap Kc E), deriv_algebraMap, T.hC, map_zero]
    have := (hs.const_mul _ hd).hasElementaryIntegral
    convert this using 1
    rw [← mul_assoc, ← Rat.cast_mul, inv_mul_cancel₀ hβ0, Rat.cast_one, one_mul]

end NestMTower

end Tower.NestM
