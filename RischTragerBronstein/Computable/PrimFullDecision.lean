import RischTragerBronstein.Computable.PrimResidueStrong
import RischTragerBronstein.Computable.PrimPolyPositive

/-!
# The full decision for one primitive over `R(x)`

`K = R(x)(t)`, `t′ = η ∈ R(x)` not a derivative (e.g. `t = log b(x)`). After Hermite reduction every
`f ∈ K` has the form

  `f = g′ + ∑_{j ≤ d} fⱼ(x) t ^ j + b(t) / sd(t)`,  `sd` squarefree, `deg b < deg sd`.

`primFull_decides`: `f` has an elementary integral **iff** the residue test passes
(`sd ∣ T(r, sd)`) **and** the recursive limited-integration loop `primLoop` succeeds on the
polynomial part. No assumption on constants.
-/

open Polynomial IntermediateField

set_option linter.unusedSectionVars false

namespace CPoly

open Differential

universe u

variable {R F₀ : Type*} {K : Type u} [Field R] [DecidableEq R] [CharZero R] [Field F₀] [Field K]
variable [Algebra R F₀] [Algebra F₀ K] [Algebra R K] [IsScalarTower R F₀ K]
variable [Differential F₀] [Differential K] [DifferentialAlgebra F₀ K] [CharZero K]

theorem primFull_decides (hR : ∀ r : R, (algebraMap R F₀ r)′ = 0)
    (x₀ : F₀) (hx₀ : x₀′ = 1) (hgen₀ : adjoin R {x₀} = (⊤ : IntermediateField R F₀))
    (t : K) (hgen : adjoin F₀ {t} = (⊤ : IntermediateField F₀ K))
    (En Ed : CPoly R)
    (ht : t′ = algebraMap F₀ K (aeval x₀ (toPoly En) / aeval x₀ (toPoly Ed)))
    (Iη : RationalIntegral R) (hcη : rationalCheck En Ed Iη = true) (hη0 : isZero Iη.r = false)
    (g : K) (d : ℕ) (A D : ℕ → CPoly R) (hD0 : ∀ j ≤ d, toPoly (D j) ≠ 0)
    (b sd r : F₀[X]) (hsd : Squarefree sd) (hdeg : b.degree < sd.degree)
    (hst : aeval t sd ≠ 0)
    (hr : sd ∣ r * (mapCoeffs sd +
      C (aeval x₀ (toPoly En) / aeval x₀ (toPoly Ed)) * derivative sd) - b) :
    HasElementaryIntegral (g′ + ∑ j ∈ Finset.range (d + 1),
        aeval (algebraMap F₀ K x₀) (toPoly (A j)) / aeval (algebraMap F₀ K x₀) (toPoly (D j)) *
          t ^ j + aeval t b / aeval t sd) ↔
      sd ∣ residueTest r sd ∧ (primLoop En Ed Iη A D d ([], [1])).isSome = true := by
  classical
  have hcharF₀ : CharZero F₀ := charZero_of_injective_algebraMap (algebraMap R F₀).injective
  set x : K := algebraMap F₀ K x₀ with hx
  have hx' : x′ = 1 := by rw [hx, deriv_algebraMap, hx₀, map_one]
  have hRK : ∀ r : R, (algebraMap R K r)′ = 0 := fun r ↦ by
    rw [IsScalarTower.algebraMap_apply R F₀ K, deriv_algebraMap, hR, map_zero]
  let _ : Differential R := ⟨0⟩
  have h0 : ∀ r : R, r′ = 0 := fun _ ↦ rfl
  have hDAR : DifferentialAlgebra R K := ⟨fun r ↦ by rw [hRK, h0, map_zero]⟩
  have haevx : ∀ P : R[X], aeval x P = algebraMap F₀ K (aeval x₀ P) := fun P ↦
    aeval_algebraMap_apply K x₀ P
  have ht' : t′ = aeval x (toPoly En) / aeval x (toPoly Ed) := by
    rw [ht, map_div₀, haevx, haevx]
  -- `K` is generated by `x` and `t` over `R`
  have hgenK : adjoin R {x, t} = (⊤ : IntermediateField R K) := by
    set N : IntermediateField R K := adjoin R {x, t} with hN
    have hxN : x ∈ N := subset_adjoin R _ (Set.mem_insert _ _)
    have htN : t ∈ N := subset_adjoin R _ (Set.mem_insert_of_mem _ rfl)
    have hF₀N : ∀ f : F₀, algebraMap F₀ K f ∈ N := by
      let T₀ : IntermediateField R F₀ := N.comap (IsScalarTower.toAlgHom R F₀ K)
      have hT₀ : T₀ = ⊤ := by
        rw [eq_top_iff, ← hgen₀, adjoin_le_iff]
        rintro k rfl
        exact hxN
      intro f
      have : f ∈ T₀ := hT₀ ▸ IntermediateField.mem_top
      exact this
    let N' : IntermediateField F₀ K := { N.toSubfield with algebraMap_mem' := hF₀N }
    have hN' : N' = ⊤ := by
      rw [eq_top_iff, ← hgen, adjoin_le_iff]
      rintro k rfl
      exact htN
    rw [eq_top_iff]
    intro k _
    have : k ∈ N' := hN' ▸ IntermediateField.mem_top
    exact this
  set Asum : K := ∑ j ∈ Finset.range (d + 1),
    aeval x (toPoly (A j)) / aeval x (toPoly (D j)) * t ^ j with hAsum
  -- the polynomial part as an element of `F₀[X]`
  set Apoly : F₀[X] := ∑ j ∈ Finset.range (d + 1),
    C (aeval x₀ (toPoly (A j)) / aeval x₀ (toPoly (D j))) * X ^ j with hApoly
  have hAp : aeval t Apoly = Asum := by
    simp only [hApoly, hAsum, map_sum, map_mul, map_pow, aeval_C, aeval_X, haevx, map_div₀]
  set η₀ : F₀ := aeval x₀ (toPoly En) / aeval x₀ (toPoly Ed) with hη₀
  -- the log part is integrable over every extension, once the test passes
  have hlogIn : sd ∣ residueTest r sd → HasElementaryIntegralIn (aeval t b / aeval t sd) :=
    fun hT ↦ hasElementaryIntegralIn_of_residueTest t η₀ 0
      (by rw [ht, map_zero, zero_mul, add_zero]) 1 one_ne_zero (by rw [logDeriv_one, map_zero])
      sd b r (PerfectField.separable_iff_squarefree.mpr hsd) hst hdeg
      (by rwa [C_0, zero_mul, add_zero]) hT
  constructor
  · intro hf
    -- remove the derivative
    have h1 : HasElementaryIntegral (Asum + aeval t b / aeval t sd) := by
      have := hf.sub_in (hasElementaryIntegralIn_deriv g)
      have heq : g′ + Asum + aeval t b / aeval t sd - g′ = Asum + aeval t b / aeval t sd := by
        ring
      rwa [heq] at this
    -- the residue test, applied to `(A sd + b) / sd`
    have hT : sd ∣ residueTest r sd := by
      by_contra hT
      have hr' : sd ∣ r * (mapCoeffs sd + C η₀ * derivative sd) - (Apoly * sd + b) := by
        have : r * (mapCoeffs sd + C η₀ * derivative sd) - (Apoly * sd + b) =
            (r * (mapCoeffs sd + C η₀ * derivative sd) - b) - Apoly * sd := by ring
        rw [this]
        exact dvd_sub hr (dvd_mul_left sd Apoly)
      refine not_hasElementaryIntegral_primResidue hR x₀ hx₀ hgen₀ t hgen En Ed ht Iη hcη hη0
        (Apoly * sd + b) sd r hsd hr' hT ?_
      rw [map_add, map_mul, add_div, mul_div_assoc, div_self hst, mul_one, hAp]
      exact h1
    refine ⟨hT, ?_⟩
    -- the polynomial part alone is integrable
    have h2 : HasElementaryIntegral Asum := by
      have := h1.sub_in (hlogIn hT)
      rwa [add_sub_cancel_right] at this
    by_contra hnone
    rw [Bool.not_eq_true, Option.isSome_eq_false_iff, Option.isNone_iff_eq_none] at hnone
    exact not_hasElementaryIntegral_primPoly hRK x t hx' En Ed ht' hgenK Iη hcη hη0 d A D
      (fun j _ hj ↦ hD0 j hj) hnone h2
  · rintro ⟨hT, hsome⟩
    obtain ⟨L, hL⟩ := Option.isSome_iff_exists.mp hsome
    have hA : HasElementaryIntegral Asum :=
      hasElementaryIntegral_primPoly h0 x t hx' En Ed ht' Iη hcη d A D hD0 hL
    have := ((hA.add_in (hlogIn hT)).add_in (hasElementaryIntegralIn_deriv g))
    have heq : g′ + Asum + aeval t b / aeval t sd = Asum + aeval t b / aeval t sd + g′ := by
      ring
    rwa [heq]

end CPoly
