import RischTragerBronstein.Computable.PrimNDecide

/-!
# Towers of several logarithms: examples at heights 2, 3 and 4

`tᵢ = log (x + i)` (`ηᵢ = 1 / (x + i)`), in any differential field `E` generated by `x` and the
`tᵢ` over its constants. The independence certificates and the answers are computed by the kernel
(`decide +kernel`); `primN_decides` turns them into theorems about elementary integrability.

* height 2: `∫ log x · log (x + 1)` is **not** elementary; `∫ (log x · log (x + 1))′` is.
* height 3: `∫ log x · log (x + 2)` and `∫ 1 / log (x + 2)` are not elementary; `∫ log (x + 2)` is.
* height 4: `∫ log x · log (x + 3)` is not elementary.
-/

open Differential

namespace Tower.PrimN.Examples

/-- A code of `ℚ(x)`. -/
def r (n d : CPoly ℚ) : Code 1 := (n, d)
def one₁ : Code 1 := r [1] [1]
def zero₁ : Code 1 := r [] [1]
def c2 (q : Code 1) : Code 2 := ([q], [one₁])
/-- `t₀ = log x`, as a code of `ℚ(x)(t₀)`. -/
def t1 : Code 2 := ([zero₁, one₁], [one₁])
def one₂ : Code 2 := c2 one₁
def zero₂ : Code 2 := ([], [one₁])
def c3 (q : Code 2) : Code 3 := ([q], [one₂])
def one₃ : Code 3 := c3 one₂
def zero₃ : Code 3 := ([], [one₂])
def c4 (q : Code 3) : Code 4 := ([q], [one₃])
def one₄ : Code 4 := c4 one₃
def zero₄ : Code 4 := ([], [one₃])

/-- `ηᵢ = 1 / (x + i)`. -/
def η₁ : Code 1 := r [1] [0, 1]
def η₂ : Code 1 := r [1] [1, 1]
def η₃ : Code 1 := r [1] [2, 1]
def η₄ : Code 1 := r [1] [3, 1]

set_option maxRecDepth 100000

theorem cert₂ : primCert [η₁, η₂] 2 = true := by decide +kernel
theorem cert₃ : primCert [η₁, η₂, η₃] 3 = true := by decide +kernel
theorem cert₄ : primCert [η₁, η₂, η₃, η₄] 4 = true := by decide +kernel

variable {Kc E : Type*} [Field Kc] [Field E] [Algebra Kc E] [Differential Kc] [Differential E]
variable [DifferentialAlgebra Kc E] [CharZero Kc]

/-! ### Height 2: `Kc(x, log x, log (x + 1))` -/

section Height2

variable (T : PrimTower Kc E [η₁, η₂])

/-- The value of the code `t₀ t₁`. -/
lemma val_t0t1 (h : T.Tr 2) :
    (((T.MP 2 h).sem (([zero₂, t1], [one₂]) : Code 3) : T.F 2) : E) = T.ts 0 * T.ts 1 := by
  have h1 : T.Tr 1 := fun i hi ↦ h i (by omega)
  have h0 : T.Tr 0 := fun i hi ↦ h i (by omega)
  have hz₂ : (T.MP 1 h1).sem zero₂ = 0 := (T.MP 1 h1).sem_zero
  have ho₂ : (T.MP 1 h1).sem one₂ = 1 := (T.MP 1 h1).sem_one
  have hz₁ : (T.MP 0 h0).sem zero₁ = 0 := (T.MP 0 h0).sem_zero
  have ho₁ : (T.MP 0 h0).sem one₁ = 1 := (T.MP 0 h0).sem_one
  have ht1 : (((T.MP 1 h1).sem t1 : T.F 1) : E) = T.ts 0 := by
    show ((T.phi 0 (GPoly.toPoly (T.MP 0 h0) [zero₁, one₁]) /
      T.phi 0 (GPoly.toPoly (T.MP 0 h0) [one₁]) : T.F 1) : E) = _
    rw [IntermediateField.coe_div, T.coe_phi, T.coe_phi]
    simp [GPoly.toPoly_cons, hz₁, ho₁]
  show ((T.phi 1 (GPoly.toPoly (T.MP 1 h1) [zero₂, t1]) /
    T.phi 1 (GPoly.toPoly (T.MP 1 h1) [one₂]) : T.F 2) : E) = _
  rw [IntermediateField.coe_div, T.coe_phi, T.coe_phi]
  simp only [GPoly.toPoly_cons, GPoly.toPoly_nil, hz₂, ho₂, map_mul, Polynomial.aeval_C,
    Polynomial.aeval_X, mul_zero, add_zero, map_zero, map_one, div_one, zero_add]
  rw [show algebraMap (T.F 1) E ((T.MP 1 h1).sem t1) = T.ts 0 from ht1]
  ring

/-- **`∫ log x · log (x + 1) dx` is not elementary.** -/
theorem logx_log_x1_not_elementary (hgen : T.F 2 = ⊤) :
    ¬HasElementaryIntegral (T.ts 0 * T.ts 1) := by
  rw [← val_t0t1 T (T.tr_of_ND (T.nd_of_primCert 2 cert₂))]
  exact fun h ↦ absurd ((T.primN_decides 2 hgen cert₂ _).mp h) (by decide +kernel)

/-- `(log x · log (x + 1))′ = log (x + 1) / x + log x / (x + 1)` has an elementary integral
(the algorithm finds it). -/
theorem deriv_log_log_elementary (hgen : T.F 2 = ⊤) :
    HasElementaryIntegral ((((T.MP 2 (T.tr_of_ND (T.nd_of_primCert 2 cert₂))).sem
      (([([zero₁, r [1] [1, 1]], [one₁]), c2 (r [1] [0, 1])], [one₂]) : Code 3) : T.F 2) : E)) := by
  exact (T.primN_decides 2 hgen cert₂ _).mpr (by decide +kernel)

end Height2

/-! ### Height 3: `Kc(x, log x, log (x + 1), log (x + 2))` -/

section Height3

variable (T : PrimTower Kc E [η₁, η₂, η₃])

/-- `∫ log x · log (x + 2) dx` is not elementary (the code `t₀ t₂`). -/
theorem logx_log_x2_not_elementary (hgen : T.F 3 = ⊤) :
    ¬HasElementaryIntegral ((((T.MP 3 (T.tr_of_ND (T.nd_of_primCert 3 cert₃))).sem
      (([zero₃, c3 t1], [one₃]) : Code 4) : T.F 3) : E)) :=
  fun h ↦ absurd ((T.primN_decides 3 hgen cert₃ _).mp h) (by decide +kernel)

/-- `∫ dx / log (x + 2)` is not elementary (the code `1 / t₂`). -/
theorem inv_log_x2_not_elementary (hgen : T.F 3 = ⊤) :
    ¬HasElementaryIntegral ((((T.MP 3 (T.tr_of_ND (T.nd_of_primCert 3 cert₃))).sem
      (([one₃], [zero₃, one₃]) : Code 4) : T.F 3) : E)) :=
  fun h ↦ absurd ((T.primN_decides 3 hgen cert₃ _).mp h) (by decide +kernel)

/-- `(log x · log (x + 2))′` has an elementary integral. -/
theorem deriv_log_log2_elementary (hgen : T.F 3 = ⊤) :
    HasElementaryIntegral ((((T.MP 3 (T.tr_of_ND (T.nd_of_primCert 3 cert₃))).sem
      (([c3 ([zero₁, r [1] [2, 1]], [one₁]), c3 (c2 (r [1] [0, 1]))], [one₃]) : Code 4) :
        T.F 3) : E)) :=
  (T.primN_decides 3 hgen cert₃ _).mpr (by decide +kernel)

end Height3

/-! ### Height 4 -/

/-- `∫ log x · log (x + 3) dx` is not elementary, in `Kc(x, log x, …, log (x + 3))`. -/
theorem logx_log_x3_not_elementary (T : PrimTower Kc E [η₁, η₂, η₃, η₄]) (hgen : T.F 4 = ⊤) :
    ¬HasElementaryIntegral ((((T.MP 4 (T.tr_of_ND (T.nd_of_primCert 4 cert₄))).sem
      (([zero₄, c4 (c3 t1)], [one₄]) : Code 5) : T.F 4) : E)) :=
  fun h ↦ absurd ((T.primN_decides 4 hgen cert₄ _).mp h) (by decide +kernel)

end Tower.PrimN.Examples
