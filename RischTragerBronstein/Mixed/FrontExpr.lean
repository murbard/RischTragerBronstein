import RischTragerBronstein.Mixed.MTSound

/-!
# An expression front end for mixed towers

Elementary expressions over a base curve `F(x, y) = 0`:
`x`, `y`, rational constants, `+`, `·`, `−`, `⁻¹`, `exp`, `log` (`EE`).

* `nodesOf e`: the `exp`/`log` subexpressions in post-order, without repetitions. Node `i` becomes
  level `i` of a tower.
* `comp ks m e`: the code of `e` at level `m` (`none` if `e` uses a node of level `≥ m`).
* `ksB`: the kinds, built level by level (each level's code operations need the kinds below it).
  Node `i = exp a` gives `tᵢ′ = a′ tᵢ`, node `i = log a` gives `tᵢ′ = a′/a` (with `lv i = a`).
* `comp_spec`: in every tower `T` with these kinds, the code of `e` evaluates to the value
  `evE T e` (`x, y` as on the curve, node `i` as `T.ts i`).
* `frontDecide e N`: if the tower is certified (`certC`: independence of the generators by the
  structure theorem) and the base curve has valid shape, `elM` decides. **`front_decided`**: then
  for every large bound the answer is correct for every realization `T` of the tower (`hgen`:
  `L` generated by the tower).

Dependent generators (`exp x` and `exp 2x`, `log x` and `log x²`) fail `certC` and give `none`.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false

namespace Curves.MT.Front

open Curves Curves.LT Curves.MT CPoly Sup

/-- Elementary expressions over the base curve. -/
inductive EE where
  | x
  | y
  | cst (c : ℚ)
  | add (a b : EE)
  | mul (a b : EE)
  | neg (a : EE)
  | inv (a : EE)
  | exp (a : EE)
  | log (a : EE)
  deriving DecidableEq, Repr

namespace EE

/-- `a − b`. -/
def sub (a b : EE) : EE := add a (neg b)
/-- `a / b`. -/
def div (a b : EE) : EE := mul a (inv b)
/-- `aᵏ`. -/
def pow (a : EE) : ℕ → EE
  | 0 => cst 1
  | k + 1 => mul (pow a k) a

/-- The `exp`/`log` nodes, post-order, appended to `acc` without repetitions. -/
def nodesAux : EE → List EE → List EE
  | x, acc => acc
  | y, acc => acc
  | cst _, acc => acc
  | add a b, acc => nodesAux b (nodesAux a acc)
  | mul a b, acc => nodesAux b (nodesAux a acc)
  | neg a, acc => nodesAux a acc
  | inv a, acc => nodesAux a acc
  | exp a, acc => let l := nodesAux a acc; if exp a ∈ l then l else l ++ [exp a]
  | log a, acc => let l := nodesAux a acc; if log a ∈ l then l else l ++ [log a]

/-- The nodes of `e`. -/
def nodesOf (e : EE) : List EE := nodesAux e []

end EE

open EE

variable (Fc : BPoly ℚ)

/-- The code `0` of level `m` (used only for unused levels). -/
def zeroL : (m : ℕ) → LC m
  | 0 => []
  | m + 1 => ([], [])

/-- Codes of the base curve. -/
def xCode : GPoly (GFrac ℚ) := [([0, 1], [1])]
def yCode : GPoly (GFrac ℚ) := [([], [1]), ([1], [1])]
def cCode (c : ℚ) : GPoly (GFrac ℚ) := [([c], [1])]

/-- Compilation at level `0`. -/
def comp0 (O : COps (LC 0)) : EE → Option (LC 0)
  | EE.x => some xCode
  | EE.y => some yCode
  | EE.cst c => some (cCode c)
  | EE.add a b => do let u ← comp0 O a; let v ← comp0 O b; pure (O.add u v)
  | EE.mul a b => do let u ← comp0 O a; let v ← comp0 O b; pure (O.mul u v)
  | EE.neg a => (comp0 O a).map O.neg
  | EE.inv a => (comp0 O a).map O.inv
  | EE.exp _ => none
  | EE.log _ => none

/-- A code of level `m` as a code of level `m + 1`. -/
def liftL (m : ℕ) (om : LC m) (c : LC m) : LC (m + 1) := ([c], [om])

/-- The generator `tₘ` as a code of level `m + 1`. -/
def tCode (m : ℕ) (zm om : LC m) : LC (m + 1) := ([zm, om], [om])

/-- Compilation at level `m + 1`, from the compiler `low` of level `m`. -/
def compS (nodes : List EE) (m : ℕ) (O : COps (LC (m + 1))) (zm om : LC m)
    (low : EE → Option (LC m)) : EE → Option (LC (m + 1))
  | EE.x => (low EE.x).map (liftL m om)
  | EE.y => (low EE.y).map (liftL m om)
  | EE.cst c => (low (EE.cst c)).map (liftL m om)
  | EE.add a b => do
    let u ← compS nodes m O zm om low a; let v ← compS nodes m O zm om low b; pure (O.add u v)
  | EE.mul a b => do
    let u ← compS nodes m O zm om low a; let v ← compS nodes m O zm om low b; pure (O.mul u v)
  | EE.neg a => (compS nodes m O zm om low a).map O.neg
  | EE.inv a => (compS nodes m O zm om low a).map O.inv
  | EE.exp a => match nodes.idxOf? (EE.exp a) with
    | some i => if i = m then some (tCode m zm om) else if i < m then
        (low (EE.exp a)).map (liftL m om) else none
    | none => none
  | EE.log a => match nodes.idxOf? (EE.log a) with
    | some i => if i = m then some (tCode m zm om) else if i < m then
        (low (EE.log a)).map (liftL m om) else none
    | none => none

/-- **The compiler**: the code of `e` at level `m`. -/
def comp (nodes : List EE) (ks : (m : ℕ) → KindC m) : (m : ℕ) → EE → Option (LC m)
  | 0 => comp0 (MO Fc ks 0)
  | m + 1 => compS nodes m (MO Fc ks (m + 1)) (MO Fc ks m).zero (MO Fc ks m).one
      (comp nodes ks m)

/-- The kind of level `m` (node `m`), given the kinds below. -/
def kindAt (nodes : List EE) (ks : (m : ℕ) → KindC m) (m : ℕ) : KindC m :=
  match nodes[m]? with
  | some (exp a) => .exp ((comp Fc nodes ks m a).getD (zeroL m))
  | some (log a) =>
    let O := MO Fc ks m
    let g := (comp Fc nodes ks m a).getD (zeroL m)
    .prim (O.mul (O.deriv g) (O.inv g))
  | _ => .prim (zeroL m)

/-- The kinds, correct below `m`. -/
def ksB (nodes : List EE) : ℕ → (k : ℕ) → KindC k
  | 0 => fun k ↦ .prim (zeroL k)
  | m + 1 => fun k ↦ if h : k = m then h ▸ kindAt Fc nodes (ksB nodes m) m else ksB nodes m k

/-- The kinds of the tower of `e`. -/
def ksOf (e : EE) : (k : ℕ) → KindC k := ksB Fc e.nodesOf e.nodesOf.length

/-- The logarithm arguments (`lv`). -/
def lvOf (e : EE) (m : ℕ) : LC m :=
  match e.nodesOf[m]? with
  | some (log a) => (comp Fc e.nodesOf (ksOf Fc e) m a).getD (zeroL m)
  | _ => zeroL m

/-- **The front end**: `some b` decides `∫ e` (for large `N`, `front_decided`). -/
def frontDecide (e : EE) (N : ℕ) : Option Bool :=
  let n := e.nodesOf.length
  if curveShape Fc && certC Fc (ksOf Fc e) (lvOf Fc e) n then
    (comp Fc e.nodesOf (ksOf Fc e) n e).bind fun q ↦ elM Fc (ksOf Fc e) (lvOf Fc e) n q N
  else none

/-! ### The kinds are a fixed point -/

lemma MO_congr {ks ks' : (m : ℕ) → KindC m} :
    ∀ m, (∀ k < m, ks k = ks' k) → MO Fc ks m = MO Fc ks' m
  | 0, _ => rfl
  | m + 1, h => by
    rw [MO_succ, MO_succ, MO_congr m (fun k hk ↦ h k (by omega)), h m (by omega)]

lemma comp_congr (nodes : List EE) {ks ks' : (m : ℕ) → KindC m} :
    ∀ m, (∀ k < m, ks k = ks' k) → comp Fc nodes ks m = comp Fc nodes ks' m
  | 0, h => by simp only [comp]; rw [MO_congr Fc 0 h]
  | m + 1, h => by
    simp only [comp]
    rw [MO_congr Fc (m + 1) h, MO_congr Fc m (fun k hk ↦ h k (by omega)),
      comp_congr nodes m (fun k hk ↦ h k (by omega))]

lemma kindAt_congr (nodes : List EE) {ks ks' : (m : ℕ) → KindC m} (m : ℕ)
    (h : ∀ k < m, ks k = ks' k) : kindAt Fc nodes ks m = kindAt Fc nodes ks' m := by
  unfold kindAt
  rw [comp_congr Fc nodes m h, MO_congr Fc m h]

lemma ksB_lt (nodes : List EE) : ∀ N k, k < N → ksB Fc nodes N k = ksB Fc nodes (k + 1) k
  | 0, k, h => absurd h (by omega)
  | N + 1, k, h => by
    by_cases hk : k = N
    · subst hk; rfl
    · have e : ksB Fc nodes (N + 1) k = ksB Fc nodes N k := by
        simp only [ksB]; rw [dif_neg hk]
      rw [e, ksB_lt nodes N k (by omega)]

lemma ksB_self (nodes : List EE) (k : ℕ) :
    ksB Fc nodes (k + 1) k = kindAt Fc nodes (ksB Fc nodes k) k := by
  simp [ksB]

/-- **Fixed point**: below the height, the kind of level `k` is computed from the kinds. -/
lemma ksB_fix (nodes : List EE) (N k : ℕ) (hk : k < N) :
    ksB Fc nodes N k = kindAt Fc nodes (ksB Fc nodes N) k := by
  rw [ksB_lt Fc nodes N k hk, ksB_self]
  refine kindAt_congr Fc nodes k fun j hj ↦ ?_
  rw [ksB_lt Fc nodes N j (by omega), ksB_lt Fc nodes k j hj]

/-! ### Semantics -/

universe u

variable {ks : (m : ℕ) → KindC m}
variable {Cc L : Type u} [Field Cc] [Field L] [Algebra Cc L] [Differential Cc]
  [Differential L] [DifferentialAlgebra Cc L] [CharZero Cc] [CharZero L]

/-- **The value of an expression** in a tower: node `i` is `tᵢ`. -/
noncomputable def evE (T : MTower Fc ks Cc L) (nodes : List EE) : EE → L
  | EE.x => T.S.x
  | EE.y => T.S.y
  | EE.cst c => (c : L)
  | EE.add a b => evE T nodes a + evE T nodes b
  | EE.mul a b => evE T nodes a * evE T nodes b
  | EE.neg a => -evE T nodes a
  | EE.inv a => (evE T nodes a)⁻¹
  | EE.exp a => match nodes.idxOf? (EE.exp a) with
    | some i => T.ts i
    | none => 0
  | EE.log a => match nodes.idxOf? (EE.log a) with
    | some i => T.ts i
    | none => 0

lemma ev_zero_code (T : MTower Fc ks Cc L) (q : LC 0) :
    T.ev 0 q = (cM T.hC T.S T.hx Fc T.hSF).sem q := rfl

lemma ev0_x (T : MTower Fc ks Cc L) : T.ev 0 xCode = T.S.x := by
  change (cM T.hC T.S T.hx Fc T.hSF).sem xCode = T.S.x
  rw [sem_cM, xCode]
  simp [GPoly.toPoly_cons, GPoly.toPoly_nil, sem_xModel, CPoly.toPoly]

lemma ev0_y (T : MTower Fc ks Cc L) : T.ev 0 yCode = T.S.y := by
  change (cM T.hC T.S T.hx Fc T.hSF).sem yCode = T.S.y
  rw [sem_cM, yCode]
  simp [GPoly.toPoly_cons, GPoly.toPoly_nil, sem_xModel, CPoly.toPoly]

lemma ev0_c (T : MTower Fc ks Cc L) (c : ℚ) : T.ev 0 (cCode c) = (c : L) := by
  change (cM T.hC T.S T.hx Fc T.hSF).sem (cCode c) = (c : L)
  rw [sem_cM, cCode]
  simp [GPoly.toPoly_cons, GPoly.toPoly_nil, sem_xModel, CPoly.toPoly]

lemma ev_pair (T : MTower Fc ks Cc L) (m : ℕ) (p q : GPoly (LC m)) :
    T.ev (m + 1) (p, q) = T.evP m p / T.evP m q := rfl

lemma comp0_spec (T : MTower Fc ks Cc L) (nodes : List EE) (h : T.Tr 0) :
    ∀ (e : EE) (c : LC 0), comp0 (MO Fc ks 0) e = some c → T.ev 0 c = evE Fc T nodes e
  | EE.x, c, hc => by cases hc; exact ev0_x Fc T
  | EE.y, c, hc => by cases hc; exact ev0_y Fc T
  | EE.cst q, c, hc => by cases hc; exact ev0_c Fc T q
  | EE.add a b, c, hc => by
    simp only [comp0, Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def,
      Option.some.injEq] at hc
    obtain ⟨u, hu, v, hv, rfl⟩ := hc
    rw [← T.sem_MP 0 h, (T.MP 0 h).sem_add, IntermediateField.coe_add, T.sem_MP, T.sem_MP,
      comp0_spec T nodes h a u hu, comp0_spec T nodes h b v hv]
    rfl
  | EE.mul a b, c, hc => by
    simp only [comp0, Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def,
      Option.some.injEq] at hc
    obtain ⟨u, hu, v, hv, rfl⟩ := hc
    rw [← T.sem_MP 0 h, (T.MP 0 h).sem_mul, IntermediateField.coe_mul, T.sem_MP, T.sem_MP,
      comp0_spec T nodes h a u hu, comp0_spec T nodes h b v hv]
    rfl
  | EE.neg a, c, hc => by
    simp only [comp0, Option.map_eq_some_iff] at hc
    obtain ⟨u, hu, rfl⟩ := hc
    rw [← T.sem_MP 0 h, (T.MP 0 h).sem_neg, IntermediateField.coe_neg, T.sem_MP,
      comp0_spec T nodes h a u hu]
    rfl
  | EE.inv a, c, hc => by
    simp only [comp0, Option.map_eq_some_iff] at hc
    obtain ⟨u, hu, rfl⟩ := hc
    rw [← T.sem_MP 0 h, (T.MP 0 h).sem_inv, IntermediateField.coe_inv, T.sem_MP,
      comp0_spec T nodes h a u hu]
    rfl
  | EE.exp _, c, hc => by cases hc
  | EE.log _, c, hc => by cases hc

lemma evP_single (T : MTower Fc ks Cc L) (m : ℕ) (c : LC m) : T.evP m [c] = T.ev m c := by
  simp [MTower.evP, evPL]

lemma evP_pair (T : MTower Fc ks Cc L) (m : ℕ) (c d : LC m) :
    T.evP m [c, d] = T.ev m c + T.ts m * T.ev m d := by
  simp [MTower.evP, evPL]

lemma compS_spec (T : MTower Fc ks Cc L) (nodes : List EE) (m : ℕ) (h : T.Tr (m + 1))
    (low : ∀ e c, comp Fc nodes ks m e = some c → T.ev m c = evE Fc T nodes e) :
    ∀ (e : EE) (c : LC (m + 1)), comp Fc nodes ks (m + 1) e = some c →
      T.ev (m + 1) c = evE Fc T nodes e := by
  have h' : T.Tr m := h.of_succ
  have hone : T.ev m (MO Fc ks m).one = 1 := by
    rw [← T.sem_MP m h', (T.MP m h').sem_one]; rfl
  have hzero : T.ev m (MO Fc ks m).zero = 0 := by
    rw [← T.sem_MP m h', (T.MP m h').sem_zero]; rfl
  have hlift : ∀ c, T.ev (m + 1) (liftL m (MO Fc ks m).one c) = T.ev m c := fun c ↦ by
    rw [liftL, ev_pair, evP_single, evP_single, hone, div_one]
  have ht : T.ev (m + 1) (tCode m (MO Fc ks m).zero (MO Fc ks m).one) = T.ts m := by
    rw [tCode, ev_pair, evP_pair, evP_single, hone, hzero, div_one, zero_add, mul_one]
  have hop : ∀ (c : LC (m + 1)), T.ev (m + 1) c = ((T.MP (m + 1) h).sem c : L) :=
    fun c ↦ (T.sem_MP (m + 1) h c).symm
  intro e
  induction e with
  | x => intro c hc
         simp only [comp, compS, Option.map_eq_some_iff] at hc
         obtain ⟨d, hd, rfl⟩ := hc
         rw [hlift, low _ _ hd]
  | y => intro c hc
         simp only [comp, compS, Option.map_eq_some_iff] at hc
         obtain ⟨d, hd, rfl⟩ := hc
         rw [hlift, low _ _ hd]
  | cst q => intro c hc
             simp only [comp, compS, Option.map_eq_some_iff] at hc
             obtain ⟨d, hd, rfl⟩ := hc
             rw [hlift, low _ _ hd]
  | add a b iha ihb =>
    intro c hc
    simp only [comp, compS, Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def,
      Option.some.injEq] at hc
    obtain ⟨u, hu, v, hv, rfl⟩ := hc
    rw [hop, (T.MP (m + 1) h).sem_add, IntermediateField.coe_add, ← hop, ← hop,
      iha u (by simpa only [comp] using hu), ihb v (by simpa only [comp] using hv)]
    rfl
  | mul a b iha ihb =>
    intro c hc
    simp only [comp, compS, Option.bind_eq_bind, Option.bind_eq_some_iff, Option.pure_def,
      Option.some.injEq] at hc
    obtain ⟨u, hu, v, hv, rfl⟩ := hc
    rw [hop, (T.MP (m + 1) h).sem_mul, IntermediateField.coe_mul, ← hop, ← hop,
      iha u (by simpa only [comp] using hu), ihb v (by simpa only [comp] using hv)]
    rfl
  | neg a iha =>
    intro c hc
    simp only [comp, compS, Option.map_eq_some_iff] at hc
    obtain ⟨u, hu, rfl⟩ := hc
    rw [hop, (T.MP (m + 1) h).sem_neg, IntermediateField.coe_neg, ← hop,
      iha u (by simpa only [comp] using hu)]
    rfl
  | inv a iha =>
    intro c hc
    simp only [comp, compS, Option.map_eq_some_iff] at hc
    obtain ⟨u, hu, rfl⟩ := hc
    rw [hop, (T.MP (m + 1) h).sem_inv, IntermediateField.coe_inv, ← hop,
      iha u (by simpa only [comp] using hu)]
    rfl
  | exp a _ =>
    intro c hc
    simp only [comp, compS] at hc
    simp only [evE]
    rcases hi : nodes.idxOf? (EE.exp a) with _ | i
    · rw [hi] at hc; cases hc
    · rw [hi] at hc
      simp only at hc ⊢
      by_cases him : i = m
      · rw [if_pos him] at hc; cases hc; rw [ht, him]
      · rw [if_neg him] at hc
        by_cases hil : i < m
        · rw [if_pos hil, Option.map_eq_some_iff] at hc
          obtain ⟨d, hd, rfl⟩ := hc
          rw [hlift, low _ _ hd]
          simp only [evE, hi]
        · rw [if_neg hil] at hc; cases hc
  | log a _ =>
    intro c hc
    simp only [comp, compS] at hc
    simp only [evE]
    rcases hi : nodes.idxOf? (EE.log a) with _ | i
    · rw [hi] at hc; cases hc
    · rw [hi] at hc
      simp only at hc ⊢
      by_cases him : i = m
      · rw [if_pos him] at hc; cases hc; rw [ht, him]
      · rw [if_neg him] at hc
        by_cases hil : i < m
        · rw [if_pos hil, Option.map_eq_some_iff] at hc
          obtain ⟨d, hd, rfl⟩ := hc
          rw [hlift, low _ _ hd]
          simp only [evE, hi]
        · rw [if_neg hil] at hc; cases hc

/-- **The compiled code has the value of the expression.** -/
theorem comp_spec (T : MTower Fc ks Cc L) (nodes : List EE) :
    ∀ (m : ℕ) (h : T.Tr m) (e : EE) (c : LC m), comp Fc nodes ks m e = some c →
      T.ev m c = evE Fc T nodes e
  | 0, h, e, c, hc => comp0_spec Fc T nodes h e c hc
  | m + 1, h, e, c, hc => compS_spec Fc T nodes m h (comp_spec T nodes m h.of_succ) e c hc

/-! ### The decision -/

/-- **The front end decides** (curve of valid shape, certified tower): for every realization `T`
of the tower of `e` generated by it, for every large bound, `frontDecide` answers, and
`∫ e` is elementary exactly when the answer is `true`. -/
theorem front_decided (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc)
    (hsh : curveShape Fc = true) (e : EE)
    (hc : certC Fc (ksOf Fc e) (lvOf Fc e) e.nodesOf.length = true) {q : LC e.nodesOf.length}
    (hq : comp Fc e.nodesOf (ksOf Fc e) e.nodesOf.length e = some q)
    (T : MTower Fc (ksOf Fc e) Cc L) (hn : T.n = e.nodesOf.length)
    (hgen : ∀ z : L, z ∈ T.F e.nodesOf.length) :
    ∃ N₀, ∀ N, N₀ ≤ N → ∃ b, frontDecide Fc e N = some b ∧
      (HasElementaryIntegral (evE Fc T e.nodesOf e) ↔ b = true) := by
  obtain ⟨N₀, hN⟩ := elM_decides_any (lv := lvOf Fc e) hmon hdeg hsh T e.nodesOf.length hn hc hgen q
  have hTr : T.Tr e.nodesOf.length :=
    (T.mspecs hmon hdeg (lvOf Fc e) e.nodesOf.length (by omega) hc).hyp.tr
  have hval := comp_spec Fc T e.nodesOf e.nodesOf.length hTr e q hq
  refine ⟨N₀, fun N hN0 ↦ ?_⟩
  obtain ⟨b, hb, hiff, -⟩ := hN N hN0
  refine ⟨b, ?_, by rw [← hval]; exact hiff⟩
  unfold frontDecide
  simp only [hsh, hc, Bool.and_self, if_true, hq, Option.bind_some]
  exact hb

/-- **The meaning of the tower**: node `i = exp a` is an exponential of `a`, node `i = log a` a
logarithm of `a`, in every tower with the compiled kinds. -/
theorem front_nodes (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc) (e : EE)
    (hc : certC Fc (ksOf Fc e) (lvOf Fc e) e.nodesOf.length = true)
    (T : MTower Fc (ksOf Fc e) Cc L) (hn : T.n = e.nodesOf.length) (i : ℕ)
    (hi : i < e.nodesOf.length) (a : EE) {g : LC i}
    (hg : comp Fc e.nodesOf (ksOf Fc e) i a = some g) :
    (e.nodesOf[i]? = some (EE.exp a) → (T.ts i)′ = (evE Fc T e.nodesOf a)′ * T.ts i) ∧
    (e.nodesOf[i]? = some (EE.log a) →
      (T.ts i)′ = (evE Fc T e.nodesOf a)′ / evE Fc T e.nodesOf a) := by
  have hTrn := (T.mspecs hmon hdeg (lvOf Fc e) e.nodesOf.length (by omega) hc).hyp.tr
  have hTr : T.Tr i := fun j hj ↦ hTrn j (by omega)
  have hks : ksOf Fc e i = kindAt Fc e.nodesOf (ksOf Fc e) i := ksB_fix Fc _ _ i hi
  have hht := T.ht i (by omega)
  have hval := comp_spec Fc T e.nodesOf i hTr a g hg
  rw [hks] at hht
  constructor
  · intro hnode
    unfold kindAt at hht
    rw [hnode] at hht
    simp only [hg, Option.getD_some, kderC] at hht
    rw [hht]
    change (T.ev i g)′ * T.ts i = _
    rw [hval]
  · intro hnode
    unfold kindAt at hht
    rw [hnode] at hht
    simp only [hg, Option.getD_some, kderC] at hht
    rw [hht]
    change T.ev i ((MO Fc (ksOf Fc e) i).mul ((MO Fc (ksOf Fc e) i).deriv g)
      ((MO Fc (ksOf Fc e) i).inv g)) = _
    rw [← T.sem_MP i hTr, (T.MP i hTr).sem_mul, (T.MP i hTr).sem_deriv, (T.MP i hTr).sem_inv,
      IntermediateField.coe_mul, IntermediateField.coe_inv, T.coe_deriv, T.sem_MP, hval,
      div_eq_mul_inv]

/-- **Every answer of the front end is correct** (at any bound): for every realization `T` of the
compiled tower generated by it. -/
theorem front_sound (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc) (e : EE) (N : ℕ)
    (b : Bool) (h : frontDecide Fc e N = some b) (T : MTower Fc (ksOf Fc e) Cc L)
    (hn : T.n = e.nodesOf.length) (hgen : ∀ z : L, z ∈ T.F e.nodesOf.length) :
    HasElementaryIntegral (evE Fc T e.nodesOf e) ↔ b = true := by
  unfold frontDecide at h
  by_cases hcs : (curveShape Fc && certC Fc (ksOf Fc e) (lvOf Fc e) e.nodesOf.length) = true
  · rw [if_pos hcs] at h
    simp only [Bool.and_eq_true] at hcs
    obtain ⟨hsh, hc⟩ := hcs
    rcases hq : comp Fc e.nodesOf (ksOf Fc e) e.nodesOf.length e with _ | q
    · rw [hq] at h; cases h
    · rw [hq, Option.bind_some] at h
      have hTr : T.Tr e.nodesOf.length :=
        (T.mspecs hmon hdeg (lvOf Fc e) e.nodesOf.length (by omega) hc).hyp.tr
      rw [← comp_spec Fc T e.nodesOf e.nodesOf.length hTr e q hq]
      exact (elM_sound hmon hdeg hsh T _ hn hc hgen q N b h).1
  · rw [if_neg hcs] at h; cases h

/-! ### Normalization of exponentials and logarithms -/

namespace EE

/-- `exp u` for a normalized `u`: sums, integer multiples, negatives and logarithms are split. -/
def expN : EE → EE
  | add u v => mul (expN u) (expN v)
  | neg u => inv (expN u)
  | mul (cst c) u =>
    if c.den = 1 then
      if 0 ≤ c.num then pow (expN u) c.num.toNat else inv (pow (expN u) c.num.natAbs)
    else exp (mul (cst c) u)
  | log u => u
  | u => exp u

/-- `log u` for a normalized `u`: products, inverses and exponentials are split. -/
def logN : EE → EE
  | mul u v => add (logN u) (logN v)
  | inv u => neg (logN u)
  | exp u => u
  | u => log u

/-- **Normalization** (bottom-up): `exp(a + b) = exp a exp b`, `exp(n a) = (exp a)ⁿ`,
`exp(log a) = a`, `log(a b) = log a + log b`, `log(1/a) = −log a`, `log(exp a) = a`. -/
def normalize : EE → EE
  | x => x
  | y => y
  | cst c => cst c
  | add a b => add (normalize a) (normalize b)
  | mul a b => mul (normalize a) (normalize b)
  | neg a => neg (normalize a)
  | inv a => inv (normalize a)
  | exp a => expN (normalize a)
  | log a => logN (normalize a)

end EE

/-- **The front end on the normalized expression.** -/
def frontDecideN (e : EE) (N : ℕ) : Option Bool := frontDecide Fc e.normalize N

namespace EE

/-- The exponential atoms `(c, u)` of `exp (c · u)` / `exp u` nodes. -/
def expAtoms : EE → List (ℚ × EE)
  | add a b => expAtoms a ++ expAtoms b
  | mul a b => expAtoms a ++ expAtoms b
  | neg a => expAtoms a
  | inv a => expAtoms a
  | log a => expAtoms a
  | exp (mul (cst c) u) => (c, u) :: expAtoms u
  | exp u => (1, u) :: expAtoms u
  | _ => []

/-- The common denominator of the coefficients of the atom `u`. -/
def atomDen (atoms : List (ℚ × EE)) (u : EE) : ℕ :=
  (atoms.filter (·.2 == u)).foldr (fun p acc ↦ Nat.lcm p.1.den acc) 1

/-- `gᵏ` for an integer `k`. -/
def zpowE (g : EE) (k : ℤ) : EE := if 0 ≤ k then pow g k.toNat else inv (pow g k.natAbs)

/-- **Common generators**: `exp(c u) = exp(u/D)^{c D}`, `D` the common denominator of the
coefficients of `u`. -/
def commonExp (atoms : List (ℚ × EE)) : EE → EE
  | add a b => add (commonExp atoms a) (commonExp atoms b)
  | mul a b => mul (commonExp atoms a) (commonExp atoms b)
  | neg a => neg (commonExp atoms a)
  | inv a => inv (commonExp atoms a)
  | log a => log (commonExp atoms a)
  | exp (mul (cst c) u) =>
    let D := atomDen atoms u
    let u' := commonExp atoms u
    if D = 1 then exp (mul (cst c) u') else zpowE (exp (mul (cst (1 / D)) u')) (c * D).num
  | exp u =>
    let D := atomDen atoms u
    let u' := commonExp atoms u
    if D = 1 then exp u' else pow (exp (mul (cst (1 / D)) u')) D
  | e => e

/-- Normalization, then common generators for rational multiples. -/
def normalize2 (e : EE) : EE := commonExp (expAtoms e.normalize) e.normalize

end EE

/-- **The front end on the normalized expression with common generators.** -/
def frontDecideN2 (e : EE) (N : ℕ) : Option Bool := frontDecide Fc e.normalize2 N

end Curves.MT.Front
