import RischTragerBronstein.Mixed.KBLift

/-!
# Changing the base curve: the decision

`kzDecide_bc_correct`: the integral of `f θʲ` over the original tower is decided by `kzDecide` run on
the translated data over the new base curve `Fc'` (where, e.g., a pole factor `t² − x` splits):
the realization `T'` of `base_change` lives in an algebraic extension `L'` of `L`, the translated
codes have the same values, `L'` is generated by `T'`'s levels and `θ`, and elementary
integrability is invariant under algebraic extensions.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false

namespace Curves.MT

open CPoly Sup Curves.LT Tower.PrimN Tower.NestP Tower.NestM Tower.NestX

universe u

namespace MTower

variable {Fc : BPoly ℚ} {ks : (m : ℕ) → KindC m}
variable {Cc L : Type u} [Field Cc] [Field L] [Algebra Cc L] [Differential Cc]
  [Differential L] [DifferentialAlgebra Cc L] [CharZero Cc] [CharZero L]

lemma evPL_tau {L L' : Type*} [Field L] [Field L'] [Differential L] [Differential L']
    (Fc' : BPoly ℚ) (Yc : GPoly (GFrac ℚ)) (j : L →+* L') (M0 : LC 0 → L) (M0' : LC 0 → L')
    (h0 : ∀ a, M0' (tau0 Fc' Yc a) = j (M0 a)) (ts : ℕ → L) (m : ℕ) (p : GPoly (LC m)) :
    evPL M0' (fun i ↦ j (ts i)) m (p.map (tauC Fc' Yc m)) = j (evPL M0 ts m p) := by
  induction p with
  | nil => simp [evPL]
  | cons a p ih =>
    simp only [evPL, List.map_cons, List.foldr_cons] at ih ⊢
    rw [ih, tau_evL Fc' Yc j M0 M0' h0 ts m a, map_add, map_mul]

set_option maxHeartbeats 4000000 in
/-- **Deciding over a new base curve.** -/
theorem kzDecide_bc_correct [Fact (Irreducible (toPoly (fKc Fc)))] (T : MTower Fc ks Cc L)
    (Q : GPoly (LC 0)) [Fact (Irreducible (toPoly (qK Fc Q)))]
    (Fc' : BPoly ℚ) [Fact (Irreducible (toPoly (fKc Fc')))] (Yc : GPoly (GFrac ℚ))
    (hbc : bcOK Fc Q Fc' Yc = true)
    (hmon' : (toB Fc').Monic) (hlen' : (toB Fc').natDegree = Fc'.length - 1)
    (hd' : 0 < (toB Fc').natDegree) (hgeo : GeomIrr.{u} Fc')
    (hdeg' : (toB Fc').natDegree = cvN Fc') (lv' : (m : ℕ) → LC m)
    (m : ℕ) (hn : T.n = m + 1) (hc' : certC Fc' (tauK Fc' Yc ks) lv' (m + 1) = true)
    {g : LC m} (hk : ks m = .exp g) (n j : ℕ) (M : CPoly ℚ)
    [Fact (Irreducible (toPoly (liftQ Fc' m M)))] [Fact (Irreducible (toPoly (liftQ Fc' (m + 1) M)))]
    (zN : CPoly ℚ) (gs : List (CPoly ℚ)) (A : GPoly (LC m))
    (hsqc : GPoly.squarefreeCheck (MO Fc' (tauK Fc' Yc ks) m) (A.map (tauC Fc' Yc m)) = true)
    (hdegpos : 0 < degG (MO Fc' (tauK Fc' Yc ks) m) (A.map (tauC Fc' Yc m)))
    (hcop : Nat.Coprime n (degG (MO Fc' (tauK Fc' Yc ks) m) (A.map (tauC Fc' Yc m))))
    (θ : L) (hθ : θ ^ n = T.evP m A)
    (hgen : ∀ z : L, z ∈ IntermediateField.adjoin (T.F (m + 1)) {θ})
    (f : LC (m + 1)) (B' : GPoly (LC m)) (kt l : ℕ) (cs : List (NFM Fc' m M)) (dC : GPoly (LC m))
    (hf : tauC Fc' Yc (m + 1) f =
      ((B', kzDen Fc' (tauK Fc' Yc ks) m (A.map (tauC Fc' Yc m)) kt l dC) : LC (m + 1)))
    (ps : List ℕ) (bound : ℕ) (rs : ℕ → ℕ) (b : Bool)
    {cpf : CPoly (NFM Fc' m M) → CertProv (NFM Fc' m M)}
    (hdec : kzDecideC Fc' (tauK Fc' Yc ks) lv' m n j (tauC Fc' Yc m g) M zN gs
      (A.map (tauC Fc' Yc m)) B' kt l cs dC cpf ps bound rs = some b) :
    HasElementaryIntegral (T.ev (m + 1) f * θ ^ j) ↔ b = true := by
  classical
  obtain ⟨L', _, _, _, _, _, halg, T', hTn, hts, hev, hmem, hgenw⟩ :=
    T.base_change Q Fc' Yc hbc hmon' hlen' hd' hgeo
  set ι := algebraMap L L' with hι
  have hevP : T'.evP m (A.map (tauC Fc' Yc m)) = ι (T.evP m A) := by
    have h0 : ∀ a, (cM T'.hC T'.S T'.hx Fc' T'.hSF).sem (tau0 Fc' Yc a) =
        ι ((cM T.hC T.S T.hx Fc T.hSF).sem a) := fun a ↦ hev 0 a
    have hts' : T'.ts = fun i ↦ ι (T.ts i) := funext hts
    show evPL _ T'.ts m _ = _
    rw [hts']
    exact evPL_tau Fc' Yc ι _ _ h0 T.ts m A
  have hθ' : (ι θ) ^ n = T'.evP m (A.map (tauC Fc' Yc m)) := by
    rw [hevP, ← map_pow, hθ]
  have hk' : tauK Fc' Yc ks m = .exp (tauC Fc' Yc m g) := by
    unfold tauK; rw [hk]
  -- `L'` is generated by `T'`'s levels and `θ`
  have hgen' : ∀ z : L', z ∈ IntermediateField.adjoin (T'.F (m + 1)) {ι θ} := by
    set K := IntermediateField.adjoin (T'.F (m + 1)) {ι θ} with hK
    have hLK : ∀ r : L, ι r ∈ K := by
      intro r
      have hr := hgen r
      induction hr using IntermediateField.adjoin_induction with
      | mem w hw =>
        rw [Set.mem_singleton_iff] at hw
        subst hw
        exact mem_adjoin_simple_self _ _
      | algebraMap w =>
        exact IntermediateField.algebraMap_mem K (⟨ι w, hmem (m + 1) _ w.2⟩ : T'.F (m + 1))
      | add w₁ w₂ _ _ h₁ h₂ => rw [map_add]; exact add_mem h₁ h₂
      | mul w₁ w₂ _ _ h₁ h₂ => rw [map_mul]; exact mul_mem h₁ h₂
      | inv w _ h₁ => rw [map_inv₀]; exact inv_mem h₁
    let K' : IntermediateField L L' :=
      { K.toSubfield with algebraMap_mem' := hLK }
    have hy : T'.S.y ∈ K := by
      have h0 : T'.S.y ∈ T'.F 0 := by
        have := T'.ev_mem 0 yCode
        rwa [show T'.ev 0 yCode = T'.S.y from sem_yCode T'.hC T'.S T'.hx Fc' T'.hSF] at this
      exact IntermediateField.algebraMap_mem K
        (⟨T'.S.y, T'.F_mono (Nat.zero_le _) h0⟩ : T'.F (m + 1))
    have hle : IntermediateField.adjoin L {T'.S.y} ≤ K' := by
      rw [IntermediateField.adjoin_le_iff]
      rintro w rfl
      exact hy
    intro z
    have hz : z ∈ K' := hle (hgenw z)
    exact hz
  have key := T'.kzDecide_correct hmon' hdeg' m (by rw [hTn, hn]) hc' hk' n j M zN gs
    (A.map (tauC Fc' Yc m)) hsqc hdegpos hcop (ι θ) hθ' hgen' B' kt l cs dC ps bound rs b hdec
  rw [← hf, hev (m + 1) f, ← map_pow, ← map_mul] at key
  rw [← key]
  exact ⟨HasElementaryIntegral.to_isAlgebraic halg, HasElementaryIntegral.of_isAlgebraic halg⟩

end MTower

end Curves.MT
