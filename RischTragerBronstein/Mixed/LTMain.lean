import RischTragerBronstein.Mixed.LTElem

/-!
# Towers of logarithms over a curve: the decision

**`elT_decides`**: let `L = Cc(x, y, t₀, …, t_{k-1})` be generated by a curve `F(x, y) = 0` over
`ℚ` and logarithms `tₘ = log uₘ` (`uₘ` given by codes of the previous levels), transcendental
over the previous levels, the constants `Cc` algebraically closed and containing all constants.
For every code `q` of level `k`, `elT Fc us k q N` answers for all large `N`, and the answer is
`true` exactly when `q` has an elementary integral over `L` — and then it has one over every
elementary extension.

The induction on `k` (`elT_step`): the level-`k + 1` integrand is Hermite-reduced in `t = tₖ`,
the residue test and the limited-integration chain at level `k` (`lchain`) are sound and
complete (the Liouville theory of `PrimGen`, applied in each elementary extension to the
realization of the tower over its constants, `exists_lift`, where transcendence transfers,
`Tr_transfer`), and the constant term is decided at level `k` inside the field `F k`, as the top
of the sub-tower of height `k` (`exists_sub`), by the induction hypothesis.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false

namespace Curves.LT

open CPoly Sup

universe u

variable (Fc : BPoly ℚ) (us : (m : ℕ) → LC m)

/-- The decision statement at height `k`, for every realization of height `k`. -/
def ELHyp (k : ℕ) : Prop :=
  ∀ (Cc L : Type u) [Field Cc] [Field L] [Algebra Cc L] [Differential Cc] [Differential L]
    [DifferentialAlgebra Cc L] [CharZero Cc] [CharZero L] [IsAlgClosed Cc]
    (T : LTower Fc us Cc L), T.n = k → T.Tr k → (∀ z : L, z ∈ T.F k) → ∀ q : LC k,
      ∃ N₀, ∀ N, N₀ ≤ N → ∃ b, elT Fc us k q N = some b ∧
        (HasElementaryIntegral (T.ev k q) ↔ b = true) ∧
        (b = true → HasElementaryIntegralIn (T.ev k q))

variable {Fc us}

/-- **The base of the induction.** -/
theorem elT_zero (hsh : curveShape Fc = true) : ELHyp.{u} Fc us 0 := by
  intro Cc L _ _ _ _ _ _ _ _ _ T _ _ hgen q
  exact el0_decides Fc T.hC T.S T.hx (fun z ↦ hgen z) T.hSF hsh q

set_option maxHeartbeats 8000000 in
/-- **The inductive step**: one more logarithm. -/
theorem elT_step (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc) (k : ℕ)
    (IH : ELHyp.{u} Fc us k) : ELHyp.{u} Fc us (k + 1) := by
  intro Cc L _ _ _ _ _ _ _ _ _ T hn hTr hgen qq
  classical
  simp only [elT]
  have hk : T.Tr k := hTr.of_succ
  have hkn : k < T.n := by omega
  have htr : Transcendental (T.F k) (T.ts k) := hTr k (by omega)
  have hsemM : ∀ a, (((T.MP k hk).sem a : T.F k) : L) = T.ev k a := T.sem_MP k hk
  have haev : ∀ p, aeval (T.ts k) (GPoly.toPoly (T.MP k hk) p) = T.evP k p :=
    T.aeval_toPoly (T.MP k hk) hsemM
  have hvalq : T.ev (k + 1) qq = aeval (T.ts k) (GPoly.toPoly (T.MP k hk) (qq : GFrac (LC k)).1) /
      aeval (T.ts k) (GPoly.toPoly (T.MP k hk) (qq : GFrac (LC k)).2) := by
    rw [haev, haev]; rfl
  rw [hvalq]
  set O := LO Fc us k with hO
  set M := T.MP k hk with hMdef
  set t := T.ts k with htdef
  set η := T.eta k with hηdef
  set A := (qq : GFrac (LC k)).1 with hAdef
  set D := (qq : GFrac (LC k)).2 with hDdef
  set w : GPoly (LC k) := [etaC Fc us k] with hwdef
  have ht' : t′ = algebraMap (T.F k) L η := T.ht' hkn
  have hgenK : IntermediateField.adjoin (T.F k) {t} = ⊤ :=
    eq_top_iff.mpr fun z _ ↦ (T.mem_F_succ).mp (hgen z)
  have hE : IsElementaryExtension (T.F k) L :=
    isElementaryExtension_log' t hgenK (T.ev k (us k)) ⟨⟨_, T.ev_mem k _⟩, rfl⟩
      (T.hu0 k hkn) (T.ht k hkn)
  -- the zero integrand
  by_cases hz : GPoly.isZero O D = true
  · have hD0 : GPoly.toPoly M D = 0 := (GPoly.isZero_iff M _).mp hz
    have h00 : HasElementaryIntegralIn (0 : L) := by
      simpa using hasElementaryIntegralIn_deriv (0 : L)
    refine ⟨0, fun N _ ↦ ⟨true, by rw [if_pos hz], ?_, fun _ ↦ ?_⟩⟩
    · rw [hD0, map_zero, div_zero]
      exact ⟨fun _ ↦ rfl, fun _ ↦ h00.hasElementaryIntegral⟩
    · rw [hD0, map_zero, div_zero]; exact h00
  have hD0 : GPoly.toPoly M D ≠ 0 := fun h0 ↦ hz ((GPoly.isZero_iff M _).mpr h0)
  have hifz : ∀ {β : Type} (a b : β), (if GPoly.isZero (LO Fc us k) D = true then a else b) = b :=
    fun a b ↦ if_neg hz
  simp only [hifz]
  have hWp : GPoly.toPoly M w = C η := T.toPoly_eta k hk
  have hw : t′ = aeval t (C η) := by rw [aeval_C, ht']
  -- the fraction field `F k ⟮t⟯`
  letI := algebraAdjoinSimple (F := T.F k) t
  letI dP : Differential (T.F k)[X] := polynomialOfDeriv (C η)
  letI : Differential (T.F k)⟮t⟯ := differentialOfDerivClosed (derivClosed_adjoin_simple t _ hw)
  haveI hFR : IsFractionRing (T.F k)[X] (T.F k)⟮t⟯ := isFractionRing_adjoin_simple t htr
  haveI hDAL : DifferentialAlgebra (T.F k)[X] (T.F k)⟮t⟯ := differentialAlgebra_adjoin_simple t _ hw
  have hD : ∀ P : (T.F k)[X], P′ = implicitDeriv (GPoly.toPoly M w) P := fun P ↦ by
    rw [hWp]; rfl
  have hφ : ∀ P : (T.F k)[X], (((algebraMap (T.F k)[X] (T.F k)⟮t⟯ P) : (T.F k)⟮t⟯) : L) =
      aeval t P := fun P ↦ algebraMap_adjoinSimple t P
  have hinjt : ∀ P : (T.F k)[X], aeval t P = 0 → P = 0 := fun P h ↦
    transcendental_iff.mp htr P h
  have hnormAll : ∀ p : (T.F k)[X], Irreducible p → ¬p ∣ p′ := fun p hp h ↦
    T.normal k htr p hp (by rw [T.wPoly_of_lt hkn]; exact h)
  have hnormal : ∀ p : (T.F k)[X], Irreducible p → p ∣ GPoly.toPoly M D →
      ¬p ∣ implicitDeriv (GPoly.toPoly M w) p := fun p hp _ h ↦
    hnormAll p hp (by rwa [hD p])
  -- (1) Hermite reduction
  have hchk := GPoly.hermiteCheck_hermite M w A D hnormal hD0
  obtain ⟨hid, hsq⟩ := GPoly.hermiteCheck_sound_in (L := (T.F k)⟮t⟯) M w A D _ hD hchk
  set h := GPoly.hermite O w A D with hh
  set Sd := GPoly.toPoly M h.s with hSd
  have hS0 : Sd ≠ 0 := hsq.ne_zero
  have hsep : Sd.Separable := PerfectField.separable_iff_squarefree.mpr hsq
  -- (2) polynomial and proper parts
  have hdm := GPoly.divMod_spec M h.b h.s
  have hdeglt := GPoly.divMod_degree_lt M h.b h.s hS0
  set qc := (GPoly.divMod O h.b h.s).1 with hqc
  set rem := (GPoly.divMod O h.b h.s).2 with hrem
  -- (3) the residue polynomial
  have hcop0 : IsCoprime Sd′ Sd := isCoprime_deriv_of_squarefree hsq fun p hp _ ↦ hnormAll p hp
  have hcop : IsCoprime (implicitDeriv (GPoly.toPoly M w) Sd) Sd := by
    rw [← hD Sd]; exact hcop0
  have hr := GPoly.residuePoly_spec M w rem h.s hS0 hcop
  set r := GPoly.toPoly M (GPoly.residuePoly O w rem h.s) with hrdef
  have hidd : implicitDeriv (GPoly.toPoly M w) Sd = mapCoeffs Sd + C η * derivative Sd := by
    rw [hWp, implicitDeriv, Derivation.add_apply, Derivation.smul_apply]
    rfl
  have hr' : Sd ∣ r * (mapCoeffs Sd + C η * derivative Sd) - GPoly.toPoly M rem := by
    rwa [hidd] at hr
  have hst : aeval t Sd ≠ 0 := fun h0 ↦ hS0 (hinjt _ h0)
  -- (4) the integrand
  set g : L := (((algebraMap (T.F k)[X] (T.F k)⟮t⟯ (GPoly.toPoly M h.gn) /
    algebraMap (T.F k)[X] (T.F k)⟮t⟯ (GPoly.toPoly M h.gd) : (T.F k)⟮t⟯)) : L) with hg
  set Pq := GPoly.toPoly M qc with hPq
  set Pr := GPoly.toPoly M rem with hPr
  have hform : aeval t (GPoly.toPoly M A) / aeval t (GPoly.toPoly M D) =
      g′ + (aeval t Pq + aeval t Pr / aeval t Sd) := by
    have hid' : aeval t (GPoly.toPoly M A) / aeval t (GPoly.toPoly M D) =
        g′ + aeval t (GPoly.toPoly M h.b) / aeval t Sd := by
      have := congrArg Subtype.val hid
      rw [IntermediateField.coe_add, IntermediateField.coe_div, IntermediateField.coe_div, hφ, hφ,
        hφ, hφ] at this
      exact this
    rw [hid', hdm, map_add, map_mul, ← hSd]
    field_simp
  -- (5) the coefficients of the polynomial part
  have hcoefF : ∀ j, Pq.coeff j = M.sem (qc.getD j O.zero) := fun j ↦
    Tower.NestP.coeff_toPoly_getD' M qc j
  have hcoef : ∀ j, ((Pq.coeff j : T.F k) : L) = T.ev k (qc.getD j O.zero) := fun j ↦ by
    rw [hcoefF, hsemM]
  have hdq : Pq.natDegree ≤ qc.length := by
    rw [natDegree_le_iff_coeff_eq_zero]
    intro N hN
    rw [hcoefF, List.getD_eq_default _ _ (by exact_mod_cast hN.le), M.sem_zero]
  have hlogIn : Sd ∣ residueTest r Sd → HasElementaryIntegralIn (aeval t Pr / aeval t Sd) :=
    fun hT ↦ hasElementaryIntegralIn_of_residueTest t η 0
      (by rw [ht', map_zero, zero_mul, add_zero]) 1 one_ne_zero
      (by rw [map_zero]; simp [logDeriv]) Sd Pr r hsep hst hdeglt
      (by rwa [C_0, zero_mul, add_zero]) hT
  -- (6) the constant term, one level down
  obtain ⟨Tk, hTkn, hTkev, hTkgen, -⟩ := T.exists_sub k hkn.le
  have hTkTr : Tk.Tr k := Tr_transfer hmon hdeg T Tk k (by omega) hk
  have constDec : ∀ c0 : LC k, ∃ N₀, ∀ N, N₀ ≤ N → ∃ b, elT Fc us k c0 N = some b ∧
      (HasElementaryIntegral (T.ev k c0) ↔ b = true) ∧
      (b = true → HasElementaryIntegralIn (T.ev k c0)) := by
    intro c0
    obtain ⟨N₀, hN₀⟩ := IH Cc (T.F k) Tk hTkn hTkTr hTkgen c0
    refine ⟨N₀, fun N hN ↦ ?_⟩
    obtain ⟨b, hb, hiff, hIn⟩ := hN₀ N hN
    have hvalL : T.ev k c0 = algebraMap (T.F k) L (Tk.ev k c0) := (hTkev k le_rfl c0).symm
    refine ⟨b, hb, ⟨fun hf ↦ hiff.mp (HasElementaryIntegral.of_extension hE (by rwa [hvalL] at hf)),
      fun hb1 ↦ by rw [hvalL]; exact hIn hb1 L hE⟩, fun hb1 ↦ by
        rw [hvalL]; exact HasElementaryIntegralIn.of_base hE (hIn hb1)⟩
  -- (7) necessity
  have hnec : HasElementaryIntegral (aeval t (GPoly.toPoly M A) / aeval t (GPoly.toPoly M D)) →
      Sd ∣ residueTest r Sd ∧ ∃ R, lchain Fc us k qc qc.length O.zero = some R ∧
        HasElementaryIntegral (T.ev k (lconst Fc us k qc R)) := by
    intro hf
    have h1 : HasElementaryIntegral (aeval t Pq + aeval t Pr / aeval t Sd) := by
      have := hf.sub_in (hasElementaryIntegralIn_deriv g)
      rwa [hform, add_sub_cancel_left] at this
    have hT : Sd ∣ residueTest r Sd := by
      obtain ⟨E, _, _, _, _, hE1, gE, hgE⟩ := h1
      haveI : CharZero E := charZero_of_injective_algebraMap (algebraMap L E).injective
      obtain ⟨TE, hTEn, hTEts, -, hTEmem⟩ := T.exists_lift E
      have htrE : Transcendental (TE.F k) (algebraMap L E t) := by
        have := Tr_transfer hmon hdeg T TE (k + 1) (by omega) hTr k (by omega)
        rwa [hTEts] at this
      exact residue_of_lift_prim (F₀ := T.F k) t hgenK η ht' Pq Pr Sd r hsq hr' E hE1 gE hgE hst
        (TE.F k) (TE.derivClosed k) (fun f ↦ hTEmem k _ f.2) htrE
    refine ⟨hT, ?_⟩
    have h2 : HasElementaryIntegral (aeval t Pq) := by
      have := h1.sub_in (hlogIn hT)
      rwa [add_sub_cancel_right] at this
    obtain ⟨E2, _, _, _, _, hE2, g2, hg2⟩ := h2
    haveI : CharZero E2 := charZero_of_injective_algebraMap (algebraMap L E2).injective
    obtain ⟨TE, hTEn, hTEts, hTEev, hTEmem⟩ := T.exists_lift E2
    set ψ := algebraMap L E2 with hψ
    have hTETr : TE.Tr (k + 1) := Tr_transfer hmon hdeg T TE (k + 1) (by omega) hTr
    have htrE : Transcendental (TE.F k) (ψ t) := by
      have := hTETr k (by omega)
      rwa [hTEts] at this
    obtain ⟨p, hpF, hrec, htop, hgsum⟩ := poly_of_lift_prim t hgenK η ht' Pq qc.length hdq E2 hE2
      g2 hg2 (TE.F k) (TE.derivClosed k) (fun f ↦ hTEmem k _ f.2) htrE
    -- the recurrence inside the lifted level
    set p' : ℕ → TE.F k := fun i ↦ ⟨p i, hpF i⟩ with hp'
    have hηE : ((TE.eta k : TE.F k) : E2) = ψ (algebraMap (T.F k) L η) := by
      rw [LTower.coe_eta, hTEev, logDeriv_algebraMap]
      rfl
    have hsemE : ∀ a, (((TE.MP k hTETr.of_succ).sem a : TE.F k) : E2) = ψ (T.ev k a) := by
      intro a; rw [TE.sem_MP, hTEev]
    have hrec' : ∀ i, 1 ≤ i → i ≤ qc.length → (p' i)′ + ((i + 1 : ℕ) : TE.F k) * TE.eta k *
        p' (i + 1) = (TE.MP k hTETr.of_succ).sem (qc.getD i O.zero) := by
      intro i h1 _
      apply Subtype.ext
      rw [IntermediateField.coe_add, IntermediateField.coe_mul, IntermediateField.coe_mul,
        LTower.coe_deriv, hηE, hsemE, ← hcoef i]
      have := hrec i h1
      push_cast at this ⊢
      exact this
    have hQ0 : (p' (qc.length + 1) - (TE.MP k hTETr.of_succ).sem O.zero)′ = 0 := by
      rw [(TE.MP k hTETr.of_succ).sem_zero, sub_zero]
      exact Subtype.ext (by rw [LTower.coe_deriv]; exact htop)
    obtain ⟨R, hR, hR1⟩ := TE.lchain_complete hmon hdeg k hTETr qc p' qc.length hrec' O.zero hQ0
    refine ⟨R, hR, E2, inferInstance, inferInstance, inferInstance, inferInstance, hE2,
      g2 - ∑ j ∈ Finset.range (qc.length + 1), p (j + 1) * ψ t ^ (j + 1) +
        (p 1 - ψ (T.ev k R)) * ψ t, ?_⟩
    have hκ : (p 1 - ψ (T.ev k R))′ = 0 := by
      have := congrArg Subtype.val hR1
      rw [LTower.coe_deriv, AddSubgroupClass.coe_sub, hsemE] at this
      exact this
    have hc0 : T.ev k (lconst Fc us k qc R) =
        T.ev k (qc.getD 0 O.zero) - algebraMap (T.F k) L η * T.ev k R := by
      rw [← hsemM, T.sem_lconst, AddSubgroupClass.coe_sub, IntermediateField.coe_mul, hsemM,
        hsemM]
      rfl
    have ha0 : algebraMap (T.F k) L (Pq.coeff 0) = T.ev k (qc.getD 0 O.zero) := hcoef 0
    rw [Derivation.map_add, hgsum, Derivation.leibniz, hκ, deriv_algebraMap, ht', hc0, ha0]
    simp only [smul_eq_mul, mul_zero, add_zero, map_sub, map_mul]
    ring
  -- (8) sufficiency, given the chain
  have hsuff : ∀ R, lchain Fc us k qc qc.length O.zero = some R → Sd ∣ residueTest r Sd →
      HasElementaryIntegralIn (T.ev k (lconst Fc us k qc R)) →
      HasElementaryIntegralIn (aeval t (GPoly.toPoly M A) / aeval t (GPoly.toPoly M D)) := by
    intro R hR hT hc
    obtain ⟨P, hPrec, ⟨q0, hq0⟩, hP1⟩ := T.lchain_sound hmon hdeg k hk qc qc.length O.zero R hR
    have htop : ((P (qc.length + 1) : T.F k) : L)′ = 0 := by
      rw [← LTower.coe_deriv, hq0, Derivation.map_add, T.deriv_ratCast, add_zero, M.sem_zero,
        Derivation.map_zero]
      rfl
    have hsum := prim_sum_deriv t (η : L) ht' (fun i ↦ T.ev k (qc.getD i O.zero))
      (fun i ↦ (P i : L)) qc.length (fun i h1 h2 ↦ by
        have := congrArg Subtype.val (hPrec i h1 h2)
        rw [IntermediateField.coe_add, IntermediateField.coe_mul, IntermediateField.coe_mul,
          LTower.coe_deriv, hsemM] at this
        push_cast at this ⊢
        exact this) htop
    have hA' : aeval t Pq = ∑ i ∈ Finset.range (qc.length + 1), T.ev k (qc.getD i O.zero) * t ^ i := by
      rw [aeval_eq_sum_range' (n := qc.length + 1) (by omega)]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [Algebra.smul_def, ← hcoef i]
      rfl
    have hL := ((hc.add (hasElementaryIntegralIn_deriv
      (∑ j ∈ Finset.range (qc.length + 1), (P (j + 1) : L) * t ^ (j + 1)))).add
        (hlogIn hT)).add (hasElementaryIntegralIn_deriv g)
    rw [hform]
    convert hL using 1
    rw [hsum, ← hsemM (lconst Fc us k qc R), T.sem_lconst, AddSubgroupClass.coe_sub,
      IntermediateField.coe_mul, hsemM, ← hP1, hA']
    ring
  -- (9) the algorithm
  cases hres : GPoly.residueCheck O w rem h.s with
  | false =>
    refine ⟨0, fun N _ ↦ ⟨false, by simp, ?_, by simp⟩⟩
    simp only [Bool.false_eq_true, iff_false]
    intro hf
    have := (GPoly.residueCheck_iff M w rem h.s hS0).mpr (hnec hf).1
    rw [hres] at this
    exact Bool.noConfusion this
  | true =>
    have hT : Sd ∣ residueTest r Sd := (GPoly.residueCheck_iff M w rem h.s hS0).mp hres
    cases hch : lchain Fc us k qc qc.length O.zero with
    | none =>
      refine ⟨0, fun N _ ↦ ⟨false, by simp, ?_, by simp⟩⟩
      simp only [Bool.false_eq_true, iff_false]
      intro hf
      obtain ⟨R, hR, -⟩ := (hnec hf).2
      rw [hch] at hR
      simp at hR
    | some R =>
      obtain ⟨N₀, hN₀⟩ := constDec (lconst Fc us k qc R)
      refine ⟨N₀, fun N hN ↦ ?_⟩
      obtain ⟨b, hb, hiff, hIn⟩ := hN₀ N hN
      refine ⟨b, by simpa using hb,
        ⟨fun hf ↦ ?_, fun hb1 ↦ (hsuff R hch hT (hIn hb1)).hasElementaryIntegral⟩,
        fun hb1 ↦ hsuff R hch hT (hIn hb1)⟩
      obtain ⟨-, R', hR', hc⟩ := hnec hf
      rw [hch, Option.some.injEq] at hR'
      subst hR'
      exact hiff.mp hc

/-- **Towers of logarithms over a curve are decided**, at every height. -/
theorem elT_decides (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc)
    (hsh : curveShape Fc = true) : ∀ k, ELHyp.{u} Fc us k
  | 0 => elT_zero hsh
  | k + 1 => elT_step hmon hdeg k (elT_decides hmon hdeg hsh k)

end Curves.LT

namespace Curves.LT

open CPoly Sup

universe u

/-- **The tower certificate**: no `ηₘ = uₘ′ / uₘ` (`m < n`) has an antiderivative in `F m`:
parametric exact integration of `ηₘ` returns no solution with non-zero parameter. -/
def ltCert (Fc : BPoly ℚ) (us : (m : ℕ) → LC m) (n : ℕ) : Bool :=
  (List.range n).all fun m ↦ (lex Fc us m [etaC Fc us m]).all fun r ↦ r.1.getD 0 0 == 0

variable {Fc : BPoly ℚ} {us : (m : ℕ) → LC m} {Cc L : Type u} [Field Cc] [Field L]
  [Algebra Cc L] [Differential Cc] [Differential L] [DifferentialAlgebra Cc L] [CharZero Cc]
  [CharZero L]

/-- **The certificate proves the transcendence of the generators.** -/
theorem LTower.Tr_of_cert (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc)
    (T : LTower Fc us Cc L) (n : ℕ) (hn : n ≤ T.n) (hc : ltCert Fc us n = true) : T.Tr n := by
  induction n with
  | zero => exact fun i hi ↦ absurd hi (Nat.not_lt_zero i)
  | succ n ih =>
    have hc' : ltCert Fc us n = true ∧
        ((lex Fc us n [etaC Fc us n]).all fun r ↦ r.1.getD 0 0 == 0) = true := by
      simp only [ltCert, List.range_succ, List.all_append, List.all_cons, List.all_nil,
        Bool.and_true, Bool.and_eq_true] at hc
      exact hc
    have hTn := ih (by omega) hc'.1
    intro i hi
    rcases Nat.lt_succ_iff_lt_or_eq.mp hi with hi | rfl
    · exact hTn i hi
    refine transcendental_primitive (T.eta i) (T.ht' (by omega)) fun y hy ↦ ?_
    obtain ⟨β, hβ, -⟩ := (T.lex_spec hmon hdeg i hTn [etaC Fc us i]).2 [1] (fun j hj ↦ by
        rcases j with _ | j
        · simp at hj
        · rfl) y (by
      rw [LTower.sumK, List.length_singleton, Finset.sum_range_one, List.getD_cons_zero,
        List.getD_cons_zero, map_one, one_mul, T.sem_eta, hy])
    have h1 := hβ 0
    rw [List.getD_cons_zero] at h1
    rw [Finset.sum_eq_zero fun k hk ↦ by
      have hk' := Finset.mem_range.mp hk
      have hmem : (lex Fc us i [etaC Fc us i]).getD k ([], zc Fc us i) ∈
          lex Fc us i [etaC Fc us i] := by
        rw [List.getD_eq_getElem _ _ hk']; exact List.getElem_mem hk'
      have := List.all_eq_true.mp hc'.2 _ hmem
      rw [beq_iff_eq] at this
      rw [this, map_zero, mul_zero]] at h1
    exact one_ne_zero h1

/-- **Towers of logarithms over a curve are decided**, the transcendence of the generators being
certified by `ltCert`. -/
theorem elT_decides_cert (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc)
    (hsh : curveShape Fc = true) [IsAlgClosed Cc] (T : LTower Fc us Cc L) (k : ℕ) (hn : T.n = k)
    (hcert : ltCert Fc us k = true) (hgen : ∀ z : L, z ∈ T.F k) (q : LC k) :
    ∃ N₀, ∀ N, N₀ ≤ N → ∃ b, elT Fc us k q N = some b ∧
      (HasElementaryIntegral (T.ev k q) ↔ b = true) ∧
      (b = true → HasElementaryIntegralIn (T.ev k q)) :=
  elT_decides hmon hdeg hsh k Cc L T hn (T.Tr_of_cert hmon hdeg k hn.ge hcert) hgen q

end Curves.LT
