import RischTragerBronstein.Mixed.MTStepE

/-!
# Mixed towers of logarithms and exponentials over a curve: the decision

**`elM_decides`**: let `L = Cc(x, y, t₀, …, t_{k-1})` be generated by a curve `F(x, y) = 0` over
`ℚ` and a tower of logarithms (`tₘ′ = ηₘ`, `ηₘ` a code of level `m`) and exponentials
(`tₘ′ = aₘ′ tₘ`, `aₘ` a code of level `m`), the constants `Cc` algebraically closed and containing
all constants, and suppose the tower certificate `certC` holds (it proves the transcendence of
every generator, the absence of new constants, and `ηₘ = vₘ′/vₘ` for the logarithms). For every
code `q` of level `k`, `elM Fc ks lv k q N` answers for all large `N`, and the answer is `true`
exactly when `q` has an elementary integral over `L` — and then it has one over every elementary
extension.

The induction on `k`: the base is the total decision on the curve; a logarithmic level is
`elM_step_prim`, an exponential level `elM_step_exp`.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false

namespace Curves.MT

open CPoly Sup Curves.LT Tower.PrimN Tower.NestP Tower.NestM Tower.NestX

universe u

variable {Fc : BPoly ℚ} {ks : (m : ℕ) → KindC m} {lv : (m : ℕ) → LC m}

/-- **The inductive step.** -/
theorem elM_step (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc) (k : ℕ)
    (IH : ELHypM.{u} Fc ks lv k) : ELHypM.{u} Fc ks lv (k + 1) := by
  intro Cc L _ _ _ _ _ _ _ _ _ T hn hc hgen qq
  rcases hk : ks k with η | a
  · exact T.elM_step_prim hmon hdeg k IH hk hn hc hgen qq
  · exact T.elM_step_exp hmon hdeg k IH hk hn hc hgen qq

/-- **Mixed towers of logarithms and exponentials over a curve are decided**, at every height. -/
theorem elM_decides (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc)
    (hsh : curveShape Fc = true) : ∀ k, ELHypM.{u} Fc ks lv k
  | 0 => elM_zero hsh
  | k + 1 => elM_step hmon hdeg k (elM_decides hmon hdeg hsh k)

end Curves.MT
