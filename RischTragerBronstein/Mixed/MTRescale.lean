import RischTragerBronstein.Mixed.MTFinal
import RischTragerBronstein.Elementary.Rescale

/-!
# Mixed towers over a curve: change of the base variable

**`elM_decides_rescaled`**: let `L` be a differential field with derivation `∂` and `u ∈ L` with
`∂u ≠ 0`. If `L`, with the rescaled derivation `∂/∂u = (∂u)⁻¹ ∂`, is generated by a certified mixed
tower over a curve `F(u, w) = 0` in the variable `u`, then `elM` decides the elementary
integrability of `f` for `∂` through the code of `f / ∂u` (`∫ f dx = ∫ (f / u′) du`).

This moves an algebraic function of one logarithm or exponential into the base curve: for
`∫ R(x, √(log x)) dx`, `u = log x`, `w = √u`, and `x = exp u` is an exponential level over the curve
`w² = u` (`dx/du = x`); for `∫ R(x, √(eˣ + 1)) dx`, `u = eˣ`, `w = √(u + 1)`, and `x = log u`.
-/

open Polynomial Differential IntermediateField

set_option linter.unusedSectionVars false

namespace Curves.MT

open CPoly Sup Curves.LT Tower.PrimN Tower.NestP Tower.NestM Tower.NestX

universe u

variable {Fc : BPoly ℚ} {ks : (m : ℕ) → KindC m} {lv : (m : ℕ) → LC m}

/-- **The decision after a change of the base variable.** `L` carries the derivation `∂ᵤ` of the
tower (in which the base variable `u` has derivative `1`); the original derivation is `∂ = v ∂ᵤ`
(`v = ∂u`). -/
theorem elM_decides_rescaled (hmon : (toB Fc).Monic) (hdeg : (toB Fc).natDegree = cvN Fc)
    (hsh : curveShape Fc = true) {Cc L : Type u} [Field Cc] [Field L] [Algebra Cc L]
    [Differential Cc] [DL : Differential L] [DifferentialAlgebra Cc L] [CharZero Cc] [CharZero L]
    (T : MTower Fc ks Cc L) (k : ℕ) (hn : T.n = k) (hc : certC Fc ks lv k = true)
    (hgen : ∀ z : L, z ∈ T.F k) (v : L) (hv : v ≠ 0) (q : LC k) (f : L)
    (hf : T.ev k q = v⁻¹ * f) :
    ∃ N₀, ∀ N, N₀ ≤ N → ∃ b, elM Fc ks lv k q N = some b ∧
      (@HasElementaryIntegral L _ (rescale DL v) f ↔ b = true) := by
  obtain ⟨N₀, hN₀⟩ := elM_decides_any (lv := lv) hmon hdeg hsh T k hn hc hgen q
  refine ⟨N₀, fun N hN ↦ ?_⟩
  obtain ⟨b, hb, hiff, -⟩ := hN₀ N hN
  refine ⟨b, hb, ?_⟩
  rw [← hasElementaryIntegral_rescale_iff (rescale DL v) v⁻¹ f (inv_ne_zero hv), rescale_rescale,
    inv_mul_cancel₀ hv, rescale_one, ← hf]
  exact hiff

end Curves.MT
