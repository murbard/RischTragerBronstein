import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring
import Mathlib.Tactic.NormNum

/-!
# The Gauss–Manin vector of a Weierstrass family: addition identities

For `E : y² = x³ + A x + B` over a differential field, with `A' = A1`, `B' = B1` and
`Z = 4A³ + 27B²`, the **Gauss–Manin vector** of an affine point `R = (u, v)`, `v ≠ 0`, is
`b(R) = ((u' + h(u)) / v, (u u' + g(u)) / v)`, where `h, g` reduce `∂ω`, `∂η`
(`ω = dx/y`, `η = x dx/y`) to `α ω + β η`, `γ ω + δ η` modulo exact forms (`δ = −α`).

Under the group law, `b` is additive up to the coboundary `(−β c, c' − δ c)` with `c = −2λ`
(`λ` = slope of the chord or tangent):
* `gm1`, `gm2`: chord, all three points non-2-torsion;
* `tm1`, `tm2`: chord with `R₁ = (u₁, 0)` a 2-torsion point (`b(R₁) := 0`);
* `dm1`, `dm2`: tangent (doubling).

All derivatives are atoms (`d = u'`, `e = v'`, `dL = λ'`) tied by their defining polynomial
relations, which is exactly what a derivation provides. The proofs are polynomial certificates
(computed by pseudo-division and reduction modulo the curve equations).
-/

set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

namespace Manin

variable {K : Type*} [Field K]

/-- `β` (non-zero iff `2AB' − 3A'B ≠ 0`, i.e. the `j`-invariant is non-constant). -/
def beZ (Z A B A1 B1 : K) : K := (9 * A1 * B - 6 * A * B1) / (2 * Z)
/-- `α = −δ`. -/
def alZ (Z A B A1 B1 : K) : K := (-2 * A ^ 2 * A1 - 9 * B * B1) / (2 * Z)
/-- `γ`. -/
def gaZ (Z A B A1 B1 : K) : K := (3 * A * A1 * B - 2 * A ^ 2 * B1) / (2 * Z)
/-- Exact-form correction for `∂ω`. -/
def hhZ (Z A B A1 B1 u : K) : K :=
  (4 * A ^ 2 * B1 - 6 * A * A1 * B) / Z + 2 * alZ Z A B A1 B1 * u - 2 * beZ Z A B A1 B1 * u ^ 2
/-- Exact-form correction for `∂η`. -/
def gZ (Z A B A1 B1 u : K) : K :=
  (9 * A1 * B ^ 2 - 6 * A * B * B1) / Z + 2 * gaZ Z A B A1 B1 * u + 2 * alZ Z A B A1 B1 * u ^ 2
/-- First component of the Gauss–Manin vector. -/
def b1Z (Z A B A1 B1 u v d : K) : K := (d + hhZ Z A B A1 B1 u) / v
/-- Second component of the Gauss–Manin vector. -/
def b2Z (Z A B A1 B1 u v d : K) : K := (u * d + gZ Z A B A1 B1 u) / v

set_option maxHeartbeats 4000000 in
set_option maxRecDepth 100000 in
/-- Chord, first component. -/
theorem gm1 [CharZero K] (Z A B A1 B1 u1 v1 d1 e1 u2 v2 d2 e2 l dL u3 v3 d3 : K)
    (h1 : v1 ^ 2 = u1 ^ 3 + A * u1 + B) (h2 : v2 ^ 2 = u2 ^ 3 + A * u2 + B)
    (he1 : 2 * v1 * e1 = 3 * u1 ^ 2 * d1 + A1 * u1 + A * d1 + B1)
    (he2 : 2 * v2 * e2 = 3 * u2 ^ 2 * d2 + A1 * u2 + A * d2 + B1)
    (hl : l * (u2 - u1) = v2 - v1) (hdL : dL * (u2 - u1) = e2 - e1 - l * (d2 - d1))
    (hu3 : u3 = l ^ 2 - u1 - u2) (hv3 : v3 = -(v1 + l * (u3 - u1))) (hd3 : d3 = 2 * l * dL - d1 - d2)
    (hZ : Z = 4 * A ^ 3 + 27 * B ^ 2) (hu : u2 - u1 ≠ 0) (hv1 : v1 ≠ 0) (hv2 : v2 ≠ 0)
    (hv30 : v3 ≠ 0) (hZ0 : Z ≠ 0) :
    b1Z Z A B A1 B1 u3 v3 d3 = b1Z Z A B A1 B1 u1 v1 d1 + b1Z Z A B A1 B1 u2 v2 d2 + 2 * beZ Z A B A1 B1 * l := by
  have key : b1Z Z A B A1 B1 u3 v3 d3 - (b1Z Z A B A1 B1 u1 v1 d1 + b1Z Z A B A1 B1 u2 v2 d2 + 2 * beZ Z A B A1 B1 * l) = (2*A^2*A1*u1*v2*v3 + 2*A^2*A1*u2*v1*v3 - 2*A^2*A1*u3*v1*v2 + 4*A^2*B1*v1*v2 - 4*A^2*B1*v1*v3 - 4*A^2*B1*v2*v3 - 6*A*A1*B*v1*v2 + 6*A*A1*B*v1*v3 + 6*A*A1*B*v2*v3 + 6*A*B1*l*v1*v2*v3 - 6*A*B1*u1^2*v2*v3 - 6*A*B1*u2^2*v1*v3 + 6*A*B1*u3^2*v1*v2 - 9*A1*B*l*v1*v2*v3 + 9*A1*B*u1^2*v2*v3 + 9*A1*B*u2^2*v1*v3 - 9*A1*B*u3^2*v1*v2 + 9*B*B1*u1*v2*v3 + 9*B*B1*u2*v1*v3 - 9*B*B1*u3*v1*v2 - Z*d1*v2*v3 - Z*d2*v1*v3 + Z*d3*v1*v2) / (Z*v1*v2*v3) := by
    simp only [b1Z, b2Z, hhZ, gZ, beZ, alZ, gaZ]
    field_simp
    ring
  have hP : (4*v1*v2*(u1 - u2)^4) * (2*A^2*A1*u1*v2*v3 + 2*A^2*A1*u2*v1*v3 - 2*A^2*A1*u3*v1*v2 + 4*A^2*B1*v1*v2 - 4*A^2*B1*v1*v3 - 4*A^2*B1*v2*v3 - 6*A*A1*B*v1*v2 + 6*A*A1*B*v1*v3 + 6*A*A1*B*v2*v3 + 6*A*B1*l*v1*v2*v3 - 6*A*B1*u1^2*v2*v3 - 6*A*B1*u2^2*v1*v3 + 6*A*B1*u3^2*v1*v2 - 9*A1*B*l*v1*v2*v3 + 9*A1*B*u1^2*v2*v3 + 9*A1*B*u2^2*v1*v3 - 9*A1*B*u3^2*v1*v2 + 9*B*B1*u1*v2*v3 + 9*B*B1*u2*v1*v3 - 9*B*B1*u3*v1*v2 - Z*d1*v2*v3 - Z*d2*v1*v3 + Z*d3*v1*v2) = 0 := by
    linear_combination (4*Z*u1^4*v1^2*v2^2 - 16*Z*u1^3*u2*v1^2*v2^2 + 24*Z*u1^2*u2^2*v1^2*v2^2 - 16*Z*u1*u2^3*v1^2*v2^2 + 4*Z*u2^4*v1^2*v2^2) * hd3 + (8*A^2*A1*u1^5*v1*v2^2 + 8*A^2*A1*u1^4*u2*v1^2*v2 - 32*A^2*A1*u1^4*u2*v1*v2^2 - 32*A^2*A1*u1^3*u2^2*v1^2*v2 + 48*A^2*A1*u1^3*u2^2*v1*v2^2 + 48*A^2*A1*u1^2*u2^3*v1^2*v2 - 32*A^2*A1*u1^2*u2^3*v1*v2^2 - 32*A^2*A1*u1*u2^4*v1^2*v2 + 8*A^2*A1*u1*u2^4*v1*v2^2 + 8*A^2*A1*u2^5*v1^2*v2 - 16*A^2*B1*u1^4*v1^2*v2 - 16*A^2*B1*u1^4*v1*v2^2 + 64*A^2*B1*u1^3*u2*v1^2*v2 + 64*A^2*B1*u1^3*u2*v1*v2^2 - 96*A^2*B1*u1^2*u2^2*v1^2*v2 - 96*A^2*B1*u1^2*u2^2*v1*v2^2 + 64*A^2*B1*u1*u2^3*v1^2*v2 + 64*A^2*B1*u1*u2^3*v1*v2^2 - 16*A^2*B1*u2^4*v1^2*v2 - 16*A^2*B1*u2^4*v1*v2^2 + 24*A*A1*B*u1^4*v1^2*v2 + 24*A*A1*B*u1^4*v1*v2^2 - 96*A*A1*B*u1^3*u2*v1^2*v2 - 96*A*A1*B*u1^3*u2*v1*v2^2 + 144*A*A1*B*u1^2*u2^2*v1^2*v2 + 144*A*A1*B*u1^2*u2^2*v1*v2^2 - 96*A*A1*B*u1*u2^3*v1^2*v2 - 96*A*A1*B*u1*u2^3*v1*v2^2 + 24*A*A1*B*u2^4*v1^2*v2 + 24*A*A1*B*u2^4*v1*v2^2 + 24*A*B1*l*u1^4*v1^2*v2^2 - 96*A*B1*l*u1^3*u2*v1^2*v2^2 + 144*A*B1*l*u1^2*u2^2*v1^2*v2^2 - 96*A*B1*l*u1*u2^3*v1^2*v2^2 + 24*A*B1*l*u2^4*v1^2*v2^2 - 24*A*B1*u1^6*v1*v2^2 + 96*A*B1*u1^5*u2*v1*v2^2 - 24*A*B1*u1^4*u2^2*v1^2*v2 - 144*A*B1*u1^4*u2^2*v1*v2^2 + 96*A*B1*u1^3*u2^3*v1^2*v2 + 96*A*B1*u1^3*u2^3*v1*v2^2 - 144*A*B1*u1^2*u2^4*v1^2*v2 - 24*A*B1*u1^2*u2^4*v1*v2^2 + 96*A*B1*u1*u2^5*v1^2*v2 - 24*A*B1*u2^6*v1^2*v2 - 36*A1*B*l*u1^4*v1^2*v2^2 + 144*A1*B*l*u1^3*u2*v1^2*v2^2 - 216*A1*B*l*u1^2*u2^2*v1^2*v2^2 + 144*A1*B*l*u1*u2^3*v1^2*v2^2 - 36*A1*B*l*u2^4*v1^2*v2^2 + 36*A1*B*u1^6*v1*v2^2 - 144*A1*B*u1^5*u2*v1*v2^2 + 36*A1*B*u1^4*u2^2*v1^2*v2 + 216*A1*B*u1^4*u2^2*v1*v2^2 - 144*A1*B*u1^3*u2^3*v1^2*v2 - 144*A1*B*u1^3*u2^3*v1*v2^2 + 216*A1*B*u1^2*u2^4*v1^2*v2 + 36*A1*B*u1^2*u2^4*v1*v2^2 - 144*A1*B*u1*u2^5*v1^2*v2 + 36*A1*B*u2^6*v1^2*v2 + 36*B*B1*u1^5*v1*v2^2 + 36*B*B1*u1^4*u2*v1^2*v2 - 144*B*B1*u1^4*u2*v1*v2^2 - 144*B*B1*u1^3*u2^2*v1^2*v2 + 216*B*B1*u1^3*u2^2*v1*v2^2 + 216*B*B1*u1^2*u2^3*v1^2*v2 - 144*B*B1*u1^2*u2^3*v1*v2^2