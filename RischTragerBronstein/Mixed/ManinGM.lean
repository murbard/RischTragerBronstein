  have hP : (32*v1^5) * (-2*A^2*A1*l*v1*v3 + 4*A^2*A1*u1^2*v3 - 2*A^2*A1*u3^2*v1 + 4*A^2*B1*u1*v3 - 2*A^2*B1*u3*v1 - 6*A*A1*B*u1*v3 + 3*A*A1*B*u3*v1 - 6*A*B*B1*v1 + 12*A*B*B1*v3 + 9*A1*B^2*v1 - 18*A1*B^2*v3 - 9*B*B1*l*v1*v3 + 18*B*B1*u1^2*v3 - 9*B*B1*u3^2*v1 - 2*Z*d1*u1*v3 + Z*d3*u3*v1 + 2*Z*dL*v1*v3) = 0 := by
