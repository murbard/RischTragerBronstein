/-!
# Example: two places at infinity over `log x`

Tower `x`, `t = log x`, and `θ² = t (1 + 25 t)(1 − 2 t)(1 − 50 t)`: a quartic with leading
coefficient `2500 = 50²`, so the curve has **two places at infinity** (`θ ~ ±50 t²`) and
`nkShape` fails. Inverting (`x′ = 1/t`, `y′ = θ/t²`) gives the elliptic curve
`y′² = (x′ + 25)(x′ − 2)(x′ − 50)`, on which the two places become `(0, ±50)`; their difference
`2 (0, 50) − 2 O` is not torsion (the point `(0, 50)` has non-integral multiples). This is
certified (`TwoPlaceCertP`, over `ℚ(i)`, primes `13` and `17`) and checked by the kernel below; the
curve is Eisenstein at `t = 0`. So the logarithmic part of an elementary integral lies in the base
(`nk_iff2`) and, `τ(θ) = 0` and `exactC` finding `θ` not exact, **`∫ θ dx` is not elementary**.
The `exactC` computation is checked by `#guard` (its kernel evaluation needs more than 30 GB) and
enters `not_elementary` as the hypothesis `hres`.
-/

namespace Curves.MT.NKInf2Ex

open Curves Curves.LT Curves.MT CPoly Sup Tower.Sys Curves.MT.NKExEx Polynomial Differential GTors

/-- `θ² − (t − 27 t² − 1200 t³ + 2500 t⁴)`. -/
def Fq : BPoly ℚ := [[0, -1, 27, 1200, -2500], [], [1]]
/-- The inverted curve `y′² − (x′³ − 27 x′² − 1200 x′ + 2500)`. -/
def Fq' : BPoly ℚ := invB (shiftB Fq 0) 2 4

lemma Fq_eq : toB Fq = X ^ 2 + C (toPoly [0, -1, 27, 1200, -2500]) := by
  simp only [Fq, toB_cons, toB_nil, toPoly_nil, map_zero, toPoly_cons, map_one, mul_zero,
    add_zero, mul_one]; ring

lemma Fq_mon : (toB Fq).Monic := by rw [Fq_eq]; monicity!

lemma Fq_deg : (toB Fq).natDegree = 2 := by rw [Fq_eq]; compute_degree!

lemma Fq'_lit : Fq' = [[-2500, 1200, 27, -1, 0], [0, 0, 0], [1]] := by decide +kernel

lemma Fq'_eq : toB Fq' = X ^ 2 + C (toPoly [-2500, 1200, 27, -1, 0]) := by
  rw [Fq'_lit]
  simp only [toB_cons, toB_nil, toPoly_nil, map_zero, toPoly_cons, map_one, mul_zero, add_zero,
    mul_one]; ring

lemma Fq'_mon : (toB Fq').Monic := by rw [Fq'_eq]; monicity!

lemma Fq'_deg : (toB Fq').natDegree = 2 := by rw [Fq'_eq]; compute_degree!

lemma hinv : InvOK 2 4 0 (shiftB Fq 0) := invOKb_spec (by decide +kernel)

lemma heis : eisC Fq 0 = true := by decide +kernel

universe u

/-- **Geometric irreducibility** (Eisenstein at `t = 0`). -/
lemma hgeo : GeomIrr.{u} Fq :=
  geomIrr_of_eis Fq Fq_mon (by rw [Fq_deg]; rfl) (by rw [Fq_deg]; norm_num) 0 heis

def MM : CPoly ℚ := [1, 0, 1]

theorem hMM : Kron.irredQ MM = true := by decide +kernel

instance : Fact (Irreducible (toPoly MM)) := ⟨Kron.irredQ_sound MM hMM⟩

abbrev KK := NFC.NF MM

