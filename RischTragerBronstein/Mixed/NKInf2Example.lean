/-! The kernel checks. -/

set_option maxRecDepth 200000 in
lemma okFc : TT.Fc = Fq'.map (·.map (algebraMap ℚ KK)) := by decide +kernel

set_option maxRecDepth 200000 in
lemma okG : TT.globalCheck = true := by decide +kernel

set_option maxRecDepth 200000 in
lemma okPc : PcW.check TT.Fc TT.n = true := by decide +kernel

set_option maxRecDepth 200000 in
lemma okP : primeOKP (redAtM MM) TT PcW 13 Pp Qp = true := by decide +kernel

set_option maxRecDepth 200000 in
lemma okQ : primeOKP (redAtM MM) TT PcW 17 Pq Qq = true := by decide +kernel

set_option maxRecDepth 200000 in
lemma okN : nonPrincOK TT.n (pairMult 13 17 Qp.mp Qq.mp * PcW.cΓ) PbW TT.I.δL TT.I.Bc TT.I.Dc
    PcW.αs (PcW.fcerts TT.n) (PcW.bL TT.n (pairMult 13 17 Qp.mp Qq.mp)) LmW = true := by
  decide +kernel

set_option maxRecDepth 200000 in
lemma okα : PcW.fα 0 = 0 := by decide +kernel

/-- **`P₁ − P₂` is not torsion** (as a certificate for the original curve). -/
lemma hcert2 : TwoPlaceCertP KK (invB (shiftB Fq 0) 2 4) :=
  twoPlaceCertP_of_checks (redAtM MM) (redAtM_valid MM) Fq' TT PcW 13 17 Pp Pq Qp Qq PbW LmW
    (by rw [okFc, toB_mapL]) okG okPc (by norm_num) okP okQ okN rfl rfl okα

/-! The decision. -/

def Pp2 : List (GPoly (LC 0)) := liftCurve Fc ks 0 2 Fq
def PC : GPoly (LC 1) := nkPC Fc ks 0 Pp2
/-- Power sums `s₀ = 2`, `s₁ = 0`. -/
def sC : List (LC 1) := [(MOr Fc ks 1).natCast 2, zer]
/-- `f = θ`. -/
def fp : List (GPoly (LC 0)) := [[], [one0]]
def rest : List (LC 1) := nkRest Fc ks 0 (nkFl Fc ks 0 fp) (nkTau Fc ks 0 2 (nkFl Fc ks 0 fp) sC)

-- two places at infinity: the single-place shape fails
#guard nkShape Fc ks 0 Pp2 = false
-- `θ` is not exact (computed; the kernel evaluation is too large)
#guard exactC Fc ks 0 ic (paramLimC Fc ks lv 0) PC rest = some false

lemma hcertC : certC Fc ks lv 1 = true := NKNonTorsEx.hcert

set_option maxRecDepth 200000 in
lemma hs : traceC Fc ks 0 PC sC = true := by decide +kernel

lemma hmonF : (toB Fc).Monic ∧ (toB Fc).natDegree = cvN Fc := by
  have e : toB Fc = X + Polynomial.C (-X) := by
    simp [toB, CPoly.toPoly, add_comm]
  rw [e]
  exact ⟨monic_X_add_C _, by rw [natDegree_X_add_C]; rfl⟩

lemma hlen : Pp2.length = 2 := by simp [Pp2, liftCurve]

variable {Cc L : Type u} [Field Cc] [Field L] [Algebra Cc L] [Differential Cc]
  [Differential L] [DifferentialAlgebra Cc L] [CharZero Cc] [CharZero L] [IsAlgClosed Cc]

/-- **`∫ θ dx` is not elementary** for `θ² = t (1 + 25 t)(1 − 2 t)(1 − 50 t)`, `t = log x`
(two places at infinity), given the `exactC` answer (`#guard` above). -/
theorem not_elementary (T : MTower Fc ks Cc L) (hn : T.n = 1) (θ : L)
    (hθ : θ ^ 2 + ∑ i ∈ Finset.range 2, T.evP 0 (Pp2.getD i []) * θ ^ i = 0)
    (hgen : ∀ z : L, z ∈ IntermediateField.adjoin (T.F 1) {θ})
    (hres : exactC Fc ks 0 ic (paramLimC Fc ks lv 0) PC rest = some false) :
    ¬ HasElementaryIntegral (∑ j ∈ Finset.range 2, T.evP 0 (fp.getD j []) * θ ^ j) := by
  intro h
  have hiff := T.nk_iff2 hmonF.1 hmonF.2 0 hn hcertC rfl Pp2 Fq (by rw [hlen]; rfl) Fq_mon
    (by rw [Fq_deg, hlen]) (by rw [hlen]; norm_num) hgeo
    (IsAlgClosed.lift (R := ℚ) (S := KK) (M := Cc)).toRingHom 2 4 hinv Fq'_mon
    (by show (toB Fq').natDegree = _; rw [Fq'_deg, hlen]) hcert2 θ (by rw [hlen]; exact hθ) hgen sC hs fp false
    (by rw [hlen]; exact hres)
  rw [hlen] at hiff
  exact absurd (hiff.mp h).1 (by decide)

end Curves.MT.NKInf2Ex
