-- f = [0, 1764, -280, -3, 1] ; G = [1, 45, 476, 660, -3600]

/-- The transformed problem at `e = 12` (`k₀ = 2`, `DA = 3`). -/
noncomputable def probM : CurveProb QI :=
  { Fc := invB (shiftB probO.Fc 12) 2 (2 * 2), n := 2, k := 4,
    A := mobA probO.A 12 2 3,
    D := mul (reflectC (probO.D.length - 1) (compC probO.D (shiftC 12 1)))
      (xPowC (3 + 2 - (probO.D.length - 1))),
    pts := ptsM, inf := infM }

/-- The divisor `2 (0, −1) − ∞ₜ` on `w² = G(t)`. -/
noncomputable def TM : GlobalCert QI :=
  ⟨probM.Fc, 2, 2, 4, IM, cI (1/2) 0, [cI 0 0], [[cI 1 0, cI (-1) 0]], [cΓM], [[0, 2]], 1⟩

noncomputable def twM : TorsWit QI := ⟨TM, [1], 1, ⟨0, by decide +kernel⟩, 13, 73, P13M, P73M, 12, LmM⟩

set_option maxRecDepth 200000 in
lemma mobOK : mobCheck probO probM 12 2 3 = true := by decide +kernel

set_option maxRecDepth 200000 in
lemma runM : decideLogT (nfRedAt [1, 0, 1]) probM [] [twM] = some false := by decide +kernel

variable {Kc E : Type} [Field Kc] [Field E] [Algebra Kc E] [Differential Kc] [Differential E]
variable [DifferentialAlgebra Kc E] [CharZero Kc] [CharZero E] [IsAlgClosed Kc]

/-- **`∫ x dx / √(x (x − 7)(x − 14)(x + 18))` is not elementary** (the integrand of `probO` on any
curve `y² = x (x − 7)(x − 14)(x + 18)` over an algebraically closed field of constants). -/
theorem not_elementaryM (hC : ∀ c : Kc, c′ = 0) (S : CurveData Kc E) (hx : S.x′ = 1)
    (hgen : ∀ z : E, z ∈ Kc⟮S.x⟯⟮S.y⟯)
    (hSF : S.F = (toB probO.Fc).map (mapRingHom (ιI (Kc := Kc)))) :
    ¬ HasElementaryIntegral ((S.fE probO ιI : Kc⟮S.x⟯⟮S.y⟯) : E) :=
  (decideLogT_mob_spec hC S hx hgen (nfRedAt [1, 0, 1]) hred probO probM ιI hSF 12 2 3 mobOK [] [twM]
    false runM).not.mpr (by simp)

