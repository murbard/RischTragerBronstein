variable {L Kb : Type*} [Field L] [Algebra QI L] [Field Kb] [Algebra QI Kb] [IsAlgClosed Kb]

/-- **`2 P − ∞ₓ` is not torsion** on any curve `y² = x (x + 27)(x − 48)` over `ℚ(i)`. -/
theorem nonTorsion (S : CurveData QI L) (hSF : S.F = toB FcE) :
    ∀ M : ℕ, 0 < M → ¬ ∃ γ : QI⟮S.x⟯⟮S.y⟯, γ ≠ 0 ∧
      S.DivGEU (K := Kb) (fun j : Fin TE.αL.length ↦ TE.αL.getD j 0)
        (fun j (k : Fin S.F.natDegree) ↦ (TE.yL.getD j []).getD k 0)
        (fun j k ↦ M * (TE.ΓL.getD j []).getD k 0) (M * TE.cdeg) γ := by
  have hmZ : toPoly ([1, 0, 1] : CPoly ℚ) = (toPoly ([1, 0, 1] : List ℤ)).map (Int.castRingHom ℚ) := by
    simp [toPoly]
  obtain ⟨φ13, h13⟩ := nfFns_valid 13 (toPoly ([1, 0, 1] : List ℤ)) hmZ 5
    (by rw [← Jac.castL_eq, ← Kron.evalC_eq]; decide +kernel)
    (by rw [← Polynomial.derivative_map, ← Jac.castL_eq, ← CPoly.toPoly_deriv, ← Kron.evalC_eq]
        decide +kernel)
  obtain ⟨φ193, h193⟩ := nfFns_valid 193 (toPoly ([1, 0, 1] : List ℤ)) hmZ 81
    (by rw [← Jac.castL_eq, ← Kron.evalC_eq]; decide +kernel)
    (by rw [← Polynomial.derivative_map, ← Jac.castL_eq, ← CPoly.toPoly_deriv, ← Kron.evalC_eq]
        decide +kernel)
  exact not_torsion_of_cert S TE hSF hG (by norm_num) _ φ13 h13 P13 hP13 _ φ193 h193 P193 hP193
    12 LmE hNP

end Curves.NTExample
