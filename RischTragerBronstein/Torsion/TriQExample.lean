variable {Kc E : Type} [Field Kc] [Field E] [Algebra Kc E] [Differential Kc] [Differential E]
variable [DifferentialAlgebra Kc E] [CharZero Kc] [CharZero E] [IsAlgClosed Kc]

/-- **The integral is not elementary** (certificates checked above). -/
theorem not_elementary (hC : ∀ c : Kc, c′ = 0) (S : CurveData Kc E) (hx : S.x′ = 1)
    (hgen : ∀ z : E, z ∈ Kc⟮S.x⟯⟮S.y⟯)
    (hSF : S.F = (toB P0.Fc).map (mapRingHom (algebraMap ℚ Kc))) :
    ¬ HasElementaryIntegral ((S.fE P0 (algebraMap ℚ Kc) : Kc⟮S.x⟯⟮S.y⟯) : E) := by
  set ι : KK →+* Kc := (IsAlgClosed.lift (R := ℚ) (S := KK) (M := Kc)).toRingHom
  have hι : ι.comp (algebraMap ℚ KK) = algebraMap ℚ Kc := Subsingleton.elim _ _
  have hSF' : S.F = (toB Pb.Fc).map (mapRingHom ι) := by
    rw [hSF, Pb, CurveProb.baseChange, toB_mapL, Polynomial.map_map, mapRingHom_comp, hι]
  have h := not_elementary_of_torsOKP hC S hx hgen (redAtM MM) (redAtM_valid MM) Pb ι hSF' tw okAll
  rwa [Pb, S.fE_baseChange, hι] at h

